---
import DiagramFrame from "./DiagramFrame.astro";

interface Props {
  before: string[][];
  after: string[][];
  beforeLabel: string;
  afterLabel: string;
  caption: string;
}

const { before, after, beforeLabel, afterLabel, caption } = Astro.props;
---

<DiagramFrame caption={caption} label={`${beforeLabel} becomes ${afterLabel}`} class="matrix-glyph-diagram">
  <div class="matrix-glyph" role="img" aria-label={`${beforeLabel} becomes ${afterLabel}`}>
    <section>
      <strong>{beforeLabel}</strong>
      <div class="matrix-grid" style={`--columns:${before[0]?.length ?? 1}`}>
        {before.flat().map((entry) => <span>{entry}</span>)}
      </div>
    </section>
    <svg viewBox="0 0 54 30" aria-hidden="true"><path d="M3 15 H46 M37 6 L46 15 L37 24" /></svg>
    <section>
      <strong>{afterLabel}</strong>
      <div class="matrix-grid matrix-grid--after" style={`--columns:${after[0]?.length ?? 1}`}>
        {after.flat().map((entry) => <span>{entry}</span>)}
      </div>
    </section>
  </div>
</DiagramFrame>

<style>
  .matrix-glyph { display: grid; grid-template-columns: minmax(0, 1fr) 3rem minmax(0, 1fr); gap: 0.9rem; align-items: center; }
  section { display: grid; gap: 0.5rem; justify-items: center; min-width: 0; }
  .matrix-grid { display: grid; grid-template-columns: repeat(var(--columns), minmax(2.25rem, 1fr)); gap: 0.3rem; width: min(100%, 15rem); border-inline: 2px solid var(--diagram-input); padding: 0.35rem; }
  .matrix-grid--after { border-color: var(--diagram-result); }
  .matrix-grid span { display: grid; min-height: 2.1rem; place-items: center; background: var(--sl-color-bg); color: var(--sl-color-text); font-family: "STIX Two Math", Cambria, serif; font-weight: 750; }
  svg { width: 100%; }
  svg path { fill: none; stroke: var(--sl-color-accent); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  @media (max-width: 520px) {
    .matrix-glyph { grid-template-columns: 1fr; }
    svg { width: 3rem; transform: rotate(90deg); justify-self: center; }
  }
</style>
