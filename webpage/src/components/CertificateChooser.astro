---
import CertificateChooser from "./CertificateChooser.tsx";
import { certificateSources } from "../data/certificate-data";
import { renderDisplayMath } from "../lib/mathjax.js";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
// MathJax runs at build time; the hydrated island receives inert HTML strings.
const options = certificateSources.map((item) => ({
  ...item,
  mathHtml: item.formula.map(renderDisplayMath),
  href: `${base}${item.detailPath}`,
}));
---

<CertificateChooser options={options} client:visible />
