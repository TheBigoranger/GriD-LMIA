---
import DiagramFrame from "./DiagramFrame.astro";

const width = 420;
const height = 220;
const margin = { left: 42, right: 16, top: 22, bottom: 34 };
const plotWidth = width - margin.left - margin.right;
const plotHeight = height - margin.top - margin.bottom;

const sampleQuadratic = (controls: readonly number[], cell: number) => Array.from({ length: 31 }, (_, index) => {
  const alpha = index / 30;
  const rho = (cell + alpha) / 2;
  const value = (1 - alpha) ** 2 * controls[0] + 2 * alpha * (1 - alpha) * controls[1] + alpha ** 2 * controls[2];
  return { rho, value };
});
const sampleLinear = (controls: readonly number[], cell: number) => Array.from({ length: 31 }, (_, index) => {
  const alpha = index / 30;
  return { rho: (cell + alpha) / 2, value: (1 - alpha) * controls[0] + alpha * controls[1] };
});
const points = (values: readonly { rho: number; value: number }[], min: number, max: number) => values
  .map(({ rho, value }) => `${margin.left + rho * plotWidth},${margin.top + (max - value) / (max - min) * plotHeight}`)
  .join(" ");
const boundaryX = margin.left + plotWidth / 2;
---

<DiagramFrame
  class="differentiation-storage"
  label="A continuous two-cell quadratic spline and its piecewise-linear rhodiff result"
  caption="On grid [0, 0.5, 1], rhodiff differentiates each physical cell independently. The +1 rate row is shown. The −1 rate row is its negative."
>
  <div class="diff-plots">
    <section class="diff-panel">
      <header><strong>Before · degree 2</strong><code>[0.8, 2.2, 1.4] | [1.4, −0.2, 1.8]</code></header>
      <div class="diff-legend"><i></i><span>continuous quadratic spline P(ρ)</span></div>
      <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label="Continuous two-cell quadratic spline">
        <path class="diff-axis" d={`M${margin.left} ${height - margin.bottom} H${width - margin.right} M${margin.left} ${height - margin.bottom} V${margin.top}`} />
        <path class="diff-boundary" d={`M${boundaryX} ${margin.top} V${height - margin.bottom}`} />
        <polyline class="diff-curve" points={points(sampleQuadratic([0.8, 2.2, 1.4], 0), 0.5, 2)} />
        <polyline class="diff-curve" points={points(sampleQuadratic([1.4, -0.2, 1.8], 1), 0.5, 2)} />
        <circle class="diff-node" cx={boundaryX} cy={margin.top + (2 - 1.4) / 1.5 * plotHeight} r="5" />
        <text x={margin.left} y={height - 10}>0</text><text x={boundaryX} y={height - 10} text-anchor="middle">0.5</text><text x={width - margin.right} y={height - 10} text-anchor="end">1</text>
      </svg>
    </section>

    <div class="diff-arrow" aria-hidden="true"><span>rhodiff</span><i /></div>

    <section class="diff-panel diff-panel--result">
      <header><strong>After · degree 1</strong><code>[5.6, −3.2] | [−6.4, 8]</code></header>
      <div class="diff-legend"><i></i><span>rate row at ρ̇ = +1</span></div>
      <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label="Piecewise-linear cell-wise derivative row">
        <path class="diff-axis" d={`M${margin.left} ${height - margin.bottom} H${width - margin.right} M${margin.left} ${height - margin.bottom} V${margin.top}`} />
        <path class="diff-zero" d={`M${margin.left} ${margin.top + 8 / 16 * plotHeight} H${width - margin.right}`} />
        <path class="diff-boundary" d={`M${boundaryX} ${margin.top} V${height - margin.bottom}`} />
        <polyline class="diff-curve" points={points(sampleLinear([5.6, -3.2], 0), -8, 8)} />
        <polyline class="diff-curve" points={points(sampleLinear([-6.4, 8], 1), -8, 8)} />
        <circle class="diff-node" cx={boundaryX} cy={margin.top + (8 + 3.2) / 16 * plotHeight} r="4" />
        <circle class="diff-node diff-node--open" cx={boundaryX} cy={margin.top + (8 + 6.4) / 16 * plotHeight} r="4" />
        <text x={margin.left} y={height - 10}>0</text><text x={boundaryX} y={height - 10} text-anchor="middle">0.5</text><text x={width - margin.right} y={height - 10} text-anchor="end">1</text>
      </svg>
    </section>
  </div>
</DiagramFrame>

<style>
  .diff-plots { display: grid; grid-template-columns: minmax(0, 1fr) 4.5rem minmax(0, 1fr); gap: 0.75rem; align-items: center; }
  .diff-panel { min-width: 0; border: 1px solid var(--diagram-border); border-radius: 10px; padding: 0.7rem; background: var(--sl-color-bg); }
  header { display: grid; gap: 0.2rem; }
  header code { overflow-wrap: anywhere; color: var(--sl-color-gray-2); font-size: 0.72rem; }
  .diff-legend { display: flex; gap: 0.4rem; align-items: center; min-height: 1.5rem; margin-block-start: 0.45rem; color: var(--sl-color-gray-2); font-size: 0.72rem; font-weight: 700; }
  .diff-legend i { width: 1.5rem; border-block-start: 3px solid var(--diagram-input); }
  .diff-panel--result .diff-legend i { border-color: var(--diagram-result); }
  svg { display: block; width: 100%; height: auto; }
  text { fill: var(--sl-color-gray-2); font: 13px system-ui, sans-serif; }
  .diff-axis { fill: none; stroke: var(--sl-color-gray-4); stroke-width: 1.5; }
  .diff-boundary, .diff-zero { fill: none; stroke: var(--sl-color-gray-4); stroke-width: 1.2; stroke-dasharray: 5 5; }
  .diff-curve { fill: none; stroke: var(--diagram-input); stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  .diff-panel--result .diff-curve { stroke: var(--diagram-result); }
  .diff-node { fill: var(--diagram-input); stroke: var(--sl-color-bg); stroke-width: 2; }
  .diff-panel--result .diff-node { fill: var(--diagram-result); }
  .diff-node--open { fill: var(--sl-color-bg) !important; stroke: var(--diagram-result) !important; }
  .diff-arrow { display: grid; gap: 0.25rem; color: var(--sl-color-text-accent); font-size: 0.75rem; font-weight: 800; text-align: center; }
  .diff-arrow i { position: relative; display: block; border-block-start: 2px solid var(--sl-color-accent); }
  .diff-arrow i::after { position: absolute; content: ""; inset-block-start: -5px; inset-inline-end: 0; width: 8px; height: 8px; border-block-start: 2px solid var(--sl-color-accent); border-inline-end: 2px solid var(--sl-color-accent); transform: rotate(45deg); }
  @media (max-width: 760px) {
    .diff-plots { grid-template-columns: 1fr; }
    .diff-arrow { width: auto; height: 3.2rem; grid-template-rows: auto 1fr; gap: 0.15rem; justify-self: center; }
    .diff-arrow i { width: 0; height: 1.7rem; border-block-start: 0; border-inline-start: 2px solid var(--sl-color-accent); transform: none; justify-self: center; }
    .diff-arrow i::after { inset-block-start: auto; inset-block-end: 0; inset-inline-start: -5px; inset-inline-end: auto; border-block-start: 0; border-block-end: 2px solid var(--sl-color-accent); border-inline-end: 2px solid var(--sl-color-accent); transform: rotate(45deg); }
  }
</style>
