---
import DiagramFrame from "./DiagramFrame.astro";

interface Props {
  example?: "symbolic" | "numeric";
}

const { example = "symbolic" } = Astro.props;

const numeric = example === "numeric";
const caption = numeric
  ? "A quadratic row and an affine row produce four cubic coefficients: group ordered pairs by k = i + j, then apply the Bernstein binomial weights."
  : "Ordered Bernstein multiplication in three stages: read the two input rows, group contributions by k = i + j, and normalize each output coefficient.";
---

<DiagramFrame caption={caption} class="convolution-diagram">
  <div class="diagram-panels diagram-panels--three">
    <section class="diagram-panel diagram-panel--input">
      <span class="diagram-step">1</span>
      <h3>Input coefficient rows</h3>
      <div class="coefficient-line coefficient-line--first">
        <b>P</b>
        <span>{numeric ? "1" : "P₀"}</span>
        <span>{numeric ? "2" : "P₁"}</span>
        <span>{numeric ? "6" : "P₂"}</span>
      </div>
      <div class="coefficient-line coefficient-line--second">
        <b>{numeric ? "Q" : "A"}</b>
        <span>{numeric ? "2" : "A₀"}</span>
        <span>{numeric ? "4" : "A₁"}</span>
      </div>
      <p>Degrees 2 and 1.</p>
    </section>

    <section class="diagram-panel diagram-panel--contribution">
      <span class="diagram-step">2</span>
      <h3>Group ordered products</h3>
      <dl class="contribution-list">
        <div><dt>k = 0</dt><dd>(0, 0)</dd></div>
        <div><dt>k = 1</dt><dd>(0, 1), (1, 0)</dd></div>
        <div><dt>k = 2</dt><dd>(1, 1), (2, 0)</dd></div>
        <div><dt>k = 3</dt><dd>(2, 1)</dd></div>
      </dl>
      <p>The left payload stays on the left.</p>
    </section>

    <section class="diagram-panel diagram-panel--result">
      <span class="diagram-step">3</span>
      <h3>Normalize the cubic row</h3>
      {numeric ? (
        <div class="result-list">
          <span>R₀ = 2</span>
          <span>R₁ = 4</span>
          <span>R₂ = 28/3</span>
          <span>R₃ = 24</span>
        </div>
      ) : (
        <div class="result-list result-list--formula">
          <span>R₀ = P₀A₀</span>
          <span>R₁ = (P₀A₁ + 2P₁A₀)/3</span>
          <span>R₂ = (2P₁A₁ + P₂A₀)/3</span>
          <span>R₃ = P₂A₁</span>
        </div>
      )}
      <p>Degree 3; four Bernstein coefficients.</p>
    </section>
  </div>
</DiagramFrame>
