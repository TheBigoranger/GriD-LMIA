---
import DiagramFrame from "./DiagramFrame.astro";

interface Props {
  kind: "store" | "assemble" | "solve";
}

const { kind } = Astro.props;

const descriptions = {
  store: "Two physical cells store three quadratic coefficients each; the interface value is shared, leaving five global matrix controls.",
  assemble: "A cubic algebraic residual combines two cubic products with the degree-one cell-local derivative, elevated exactly for addition at two rate vertices.",
  solve: "Direct certification visits two cells, two rate rows, and four cubic labels for 16 decay constraints; positivity contributes six more.",
};
---

<DiagramFrame caption={descriptions[kind]} class="workflow-diagram">
  {kind === "store" && (
    <div class="workflow-grid workflow-grid--store">
      <section class="flow-card flow-card--neutral">
        <b>Physical grid</b>
        <span>[0, 0.5]</span>
        <span>[0.5, 1]</span>
      </section>
      <span class="flow-arrow" aria-hidden="true">→</span>
      <section class="flow-card flow-card--decision">
        <b>Quadratic P(ρ)</b>
        <span>3 local controls/cell</span>
        <span>shared interface face</span>
      </section>
      <span class="flow-arrow" aria-hidden="true">→</span>
      <section class="flow-card flow-card--result">
        <b>Global controls</b>
        <span>P₀, P₁, P₂, P₃, P₄</span>
        <span>5 full symmetric matrices</span>
      </section>
    </div>
  )}

  {kind === "assemble" && (
    <div class="workflow-grid workflow-grid--assemble">
      <section class="flow-card flow-card--decision"><b>P·A</b><span>degree 2 + 1 = 3</span></section>
      <section class="flow-card flow-card--input"><b>Aᵀ·P</b><span>degree 1 + 2 = 3</span></section>
      <section class="flow-card flow-card--contribution"><b>rhodiff(P)</b><span>degree 1, two rate rows</span></section>
      <section class="flow-card flow-card--result"><b>Aligned residual</b><span>degree 3 at ρ̇ = −1, +1</span></section>
    </div>
  )}

  {kind === "solve" && (
    <div class="workflow-grid workflow-grid--solve">
      <section class="flow-card flow-card--certificate"><b>pdlmi direct</b><span>cell-local coefficient test</span></section>
      <span class="flow-arrow" aria-hidden="true">→</span>
      <section class="flow-card flow-card--neutral"><b>toYalmip</b><span>16 decay + 6 positivity</span></section>
      <span class="flow-arrow" aria-hidden="true">→</span>
      <section class="flow-card flow-card--result"><b>SDP solver</b><span>ordinary YALMIP handoff</span></section>
    </div>
  )}
</DiagramFrame>

<style>
  .workflow-grid {
    display: grid;
    gap: 0.65rem;
    align-items: center;
  }

  .workflow-grid--store,
  .workflow-grid--solve {
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
  }

  .workflow-grid--assemble {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .workflow-grid--assemble .flow-card:last-child {
    grid-column: 1 / -1;
  }

  .flow-card {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
    place-items: center;
    border: 1px solid var(--diagram-border);
    border-radius: 10px;
    padding: 0.7rem;
    text-align: center;
    background: var(--sl-color-bg);
  }

  .flow-card span {
    color: var(--sl-color-gray-2);
    font-size: 0.74rem;
  }

  .flow-card--input { border-color: var(--diagram-input); }
  .flow-card--decision { border-color: #7c3aed; }
  .flow-card--contribution { border-color: var(--diagram-contribution); }
  .flow-card--result { border-color: var(--diagram-result); }
  .flow-card--certificate { border-color: var(--diagram-certificate); }

  .flow-arrow {
    color: var(--sl-color-text-accent);
    font-size: 1.35rem;
    font-weight: 900;
  }

  @media (max-width: 620px) {
    .workflow-grid--store,
    .workflow-grid--solve,
    .workflow-grid--assemble {
      grid-template-columns: 1fr;
    }

    .workflow-grid--assemble .flow-card:last-child {
      grid-column: auto;
    }

    .flow-arrow {
      transform: rotate(90deg);
      justify-self: center;
    }
  }
</style>
