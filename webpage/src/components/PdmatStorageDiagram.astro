---
import DiagramFrame from "./DiagramFrame.astro";
import { renderDisplayMath } from "../lib/mathjax.js";

const formula = "P_c(\\alpha)=\\sum_{i=0}^{2} B_i^2(\\alpha)P^{(c)}[i],\\qquad c=1,2.";
---

<DiagramFrame
  caption="Two quadratic cells have six local positions but five global matrix controls: P⁽¹⁾[2] and P⁽²⁾[0] are the same interface value. This enforces value continuity only."
  class="storage-diagram"
>
  <div class="storage-formula" set:html={renderDisplayMath(formula)} />
  <div class="storage-cells">
    <section class="storage-cell">
      <h3>Cell 1: ρ ∈ [0, 0.5]</h3>
      <div class="storage-row">
        <span class="face">P⁽¹⁾[0]<small>left face</small></span>
        <span class="interior">P⁽¹⁾[1]<small>interior</small></span>
        <span class="shared">P⁽¹⁾[2]<small>shared face</small></span>
      </div>
    </section>
    <section class="storage-cell">
      <h3>Cell 2: ρ ∈ [0.5, 1]</h3>
      <div class="storage-row">
        <span class="shared">P⁽²⁾[0]<small>same handle</small></span>
        <span class="interior">P⁽²⁾[1]<small>interior</small></span>
        <span class="face">P⁽²⁾[2]<small>right face</small></span>
      </div>
    </section>
  </div>
  <p class="storage-conclusion">
    <b>Conclusion:</b> the package stores a continuous piecewise-polynomial
    Bernstein representation on physical grid cells. It is not a B-spline and
    does not promise matching cell-local derivatives.
  </p>
</DiagramFrame>

<style>
  .storage-formula {
    max-width: 100%;
    margin-block-end: 0.8rem;
  }

  .storage-formula :global(mjx-container) { margin: 0; }
  .storage-formula :global(svg) { max-width: 100%; height: auto; }

  .storage-cells {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .storage-cell {
    min-width: 0;
    border: 1px solid var(--diagram-border);
    border-radius: 10px;
    padding: 0.75rem;
    background: var(--sl-color-bg);
  }

  .storage-cell h3 { margin: 0 0 0.65rem; font-size: 0.88rem; }
  .storage-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.35rem; }

  .storage-row span {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
    place-items: center;
    border: 1px solid #7c3aed;
    border-radius: 8px;
    padding: 0.5rem 0.25rem;
    text-align: center;
    overflow-wrap: anywhere;
    background: color-mix(in srgb, #7c3aed 8%, var(--sl-color-bg));
    font-size: 0.75rem;
    font-weight: 750;
  }

  .storage-row .interior { border-color: var(--diagram-contribution); }
  .storage-row .shared { border-color: var(--diagram-result); }
  .storage-row small { color: var(--sl-color-gray-2); font-size: 0.66rem; font-weight: 400; }
  .storage-conclusion { margin: 0.8rem 0 0; color: var(--sl-color-gray-2); font-size: 0.82rem; line-height: 1.5; }

  @media (max-width: 620px) {
    .storage-cells { grid-template-columns: 1fr; }
  }
</style>
