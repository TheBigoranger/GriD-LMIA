---
import DiagramFrame from "./DiagramFrame.astro";
---

<DiagramFrame
  caption="The physical grid, the shared interface, and the coefficient-to-cell mapping occupy separate rows. In two parameters, each selected degree-two cell stores a 3 × 3 tensor lattice."
  label="Separated one-dimensional cell storage and a two-dimensional degree-two coefficient lattice"
  class="cell-storage-diagram"
>
  <div class="storage-views">
    <section class="storage-panel" aria-labelledby="storage-one-title">
      <h4 id="storage-one-title">Two physical cells · three local labels each</h4>
      <div class="storage-row storage-grid-row" aria-label="Physical grid from zero to one with a boundary at one half">
        <b>physical grid</b>
        <div class="physical-track">
          <span>cell 1</span><span>cell 2</span>
          <i class="node node--start"></i><i class="node node--middle"></i><i class="node node--end"></i>
        </div>
        <div class="grid-values"><span>0</span><span>0.5</span><span>1</span></div>
      </div>
      <div class="storage-row storage-share-row">
        <b>shared interface</b>
        <p><strong>P₂</strong> is one continuous boundary handle: cell 1 label [2] = cell 2 label [0].</p>
      </div>
      <div class="storage-row storage-coeff-row">
        <b>global controls</b>
        <div class="control-strip" aria-label="Five global coefficient handles">
          <span><small>P₀</small><em>cell 1 [0]</em></span>
          <span><small>P₁</small><em>cell 1 [1]</em></span>
          <span class="shared-control"><small>P₂</small><em>cell 1 [2]<br/>cell 2 [0]</em></span>
          <span><small>P₃</small><em>cell 2 [1]</em></span>
          <span><small>P₄</small><em>cell 2 [2]</em></span>
        </div>
      </div>
      <div class="storage-row storage-map-row">
        <b>cell-local leaves</b>
        <p><code>LocalValues&#123;1&#125; = &#123;P₀,P₁,P₂&#125;</code><br/><code>LocalValues&#123;2&#125; = &#123;P₂,P₃,P₄&#125;</code></p>
      </div>
    </section>

    <section class="storage-panel" aria-labelledby="storage-two-title">
      <h4 id="storage-two-title">Selected 2-D hypercube · degree 2</h4>
      <div class="tensor-layout">
        <div class="physical-cells" aria-label="Two by two physical grid with the upper-right cell selected">
          <span></span><span class="selected"></span><span></span><span></span>
        </div>
        <span class="zoom-arrow" aria-hidden="true">→</span>
        <div>
          <strong><code>LocalValues&#123;i1&#125;&#123;i2&#125;</code></strong>
          <div class="tensor-lattice" aria-label="Nine degree-two tensor labels">
            <span>[0,0]</span><span>[0,1]</span><span>[0,2]</span>
            <span>[1,0]</span><span>[1,1]</span><span>[1,2]</span>
            <span>[2,0]</span><span>[2,1]</span><span>[2,2]</span>
          </div>
          <p>(Degree + 1)² = 9 local labels</p>
        </div>
      </div>
    </section>
  </div>
</DiagramFrame>

<style>
  .storage-views { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: clamp(1rem, 3vw, 2rem); }
  .storage-panel { min-width: 0; }
  h4 { margin: 0 0 0.75rem; color: var(--sl-color-text); font-size: 0.92rem; }
  .storage-row { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 0.75rem; align-items: center; padding: 0.65rem 0; border-block-start: 1px solid var(--diagram-border); }
  .storage-row > b { color: var(--sl-color-gray-2); font-size: 0.72rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .storage-row p { margin: 0; font-size: 0.78rem; line-height: 1.5; }
  .physical-track { position: relative; display: grid; grid-template-columns: 1fr 1fr; min-height: 2.3rem; border: 2px solid var(--diagram-border); background: var(--sl-color-bg); }
  .physical-track > span { display: grid; place-items: center; font-size: 0.75rem; font-weight: 750; }
  .physical-track > span:first-child { border-inline-end: 2px solid var(--diagram-contribution); background: color-mix(in srgb, var(--diagram-input) 9%, transparent); }
  .node { position: absolute; inset-block-start: 50%; width: 0.7rem; height: 0.7rem; border: 2px solid var(--sl-color-bg); border-radius: 50%; background: var(--sl-color-text); transform: translate(-50%, -50%); }
  .node--start { inset-inline-start: 0; }.node--middle { inset-inline-start: 50%; }.node--end { inset-inline-start: 100%; }
  .grid-values { grid-column: 2; display: flex; justify-content: space-between; margin-top: -0.55rem; font-size: 0.7rem; }
  .storage-share-row p { border-inline-start: 3px solid var(--diagram-contribution); padding-inline-start: 0.65rem; }
  .control-strip { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.3rem; }
  .control-strip span { display: grid; min-height: 3.6rem; place-items: center; border: 1px solid var(--diagram-border); border-radius: 7px; padding: 0.35rem; text-align: center; background: var(--sl-color-bg); }
  .control-strip .shared-control { border: 2px solid var(--diagram-contribution); background: color-mix(in srgb, var(--diagram-contribution) 10%, var(--sl-color-bg)); }
  .control-strip small { font-family: "STIX Two Math", Cambria, serif; font-size: 0.86rem; font-style: normal; font-weight: 800; }
  .control-strip em { color: var(--sl-color-gray-2); font-size: 0.58rem; font-style: normal; line-height: 1.25; }
  .tensor-layout { display: grid; grid-template-columns: 7rem 2rem minmax(0, 1fr); gap: 0.7rem; align-items: center; }
  .physical-cells { display: grid; grid-template-columns: 1fr 1fr; aspect-ratio: 1; border: 1px solid var(--diagram-border); }
  .physical-cells span { border: 1px solid var(--diagram-border); background: color-mix(in srgb, var(--sl-color-accent-low) 30%, transparent); }
  .physical-cells .selected { border: 2px solid var(--sl-color-accent); background: color-mix(in srgb, var(--sl-color-accent) 20%, transparent); }
  .zoom-arrow { color: var(--sl-color-text-accent); font-size: 1.4rem; text-align: center; }
  .tensor-layout > div:last-child { min-width: 0; text-align: center; }
  .tensor-lattice { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 0.55rem; border: 1px solid var(--sl-color-accent); }
  .tensor-lattice span { min-width: 0; border: 1px solid var(--diagram-border); padding: 0.65rem 0.2rem; font: 700 0.68rem "STIX Two Math", Cambria, serif; }
  .tensor-layout p { margin: 0.55rem 0 0; color: var(--sl-color-gray-2); font-size: 0.72rem; }
  @media (max-width: 820px) { .storage-views { grid-template-columns: 1fr; } }
  @media (max-width: 520px) {
    .storage-row { grid-template-columns: 1fr; gap: 0.35rem; }
    .grid-values { grid-column: 1; }
    .control-strip { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .tensor-layout { grid-template-columns: 5rem 1.5rem minmax(0, 1fr); }
  }
</style>
