---
import DiagramFrame from "./DiagramFrame.astro";
---

<DiagramFrame
  caption="Physical cells choose where data lives; degree two chooses nine local tensor labels inside the selected two-parameter cell. Shared faces reuse continuous values."
  label="One-dimensional shared-face storage and a selected two-dimensional degree-two coefficient lattice"
  class="cell-storage-diagram"
>
  <div class="storage-views">
    <section>
      <h4>Two physical cells · three local labels each</h4>
      <svg viewBox="0 0 480 270" role="img" aria-labelledby="storage-one-title storage-one-desc">
        <title id="storage-one-title">One-dimensional two-cell storage</title>
        <desc id="storage-one-desc">Two quadratic cells share the interface value at rho equals one half, leaving five global controls.</desc>
        <line x1="42" y1="70" x2="438" y2="70" class="axis" />
        <rect x="42" y="49" width="198" height="42" class="physical selected" />
        <rect x="240" y="49" width="198" height="42" class="physical" />
        <text x="141" y="76" text-anchor="middle" class="cell-name">cell 1</text>
        <text x="339" y="76" text-anchor="middle" class="cell-name">cell 2</text>
        <g class="nodes"><circle cx="42" cy="70" r="6"/><circle cx="240" cy="70" r="7"/><circle cx="438" cy="70" r="6"/></g>
        <g class="rho"><text x="42" y="112" text-anchor="middle">0</text><text x="240" y="112" text-anchor="middle">0.5</text><text x="438" y="112" text-anchor="middle">1</text></g>
        <text x="240" y="137" text-anchor="middle" class="global-label">five global controls</text>
        <g class="coeff coeff--first">
          <rect x="49" y="165" width="72" height="37" rx="6"/><rect x="125" y="165" width="72" height="37" rx="6"/>
          <text x="85" y="157" text-anchor="middle">[0]</text><text x="161" y="157" text-anchor="middle">[1]</text>
          <text x="85" y="189" text-anchor="middle">P₀</text><text x="161" y="189" text-anchor="middle">P₁</text>
        </g>
        <g class="coeff coeff--shared" aria-label="One shared interface control reused by cell 1 label [2] and cell 2 label [0]">
          <rect x="201" y="165" width="72" height="37" rx="6"/>
          <text x="237" y="157" text-anchor="middle">cell 1 label [2]</text>
          <text x="237" y="189" text-anchor="middle">P₂</text>
          <text x="237" y="220" text-anchor="middle">cell 2 label [0]</text>
        </g>
        <g class="coeff coeff--second">
          <rect x="277" y="165" width="72" height="37" rx="6"/><rect x="353" y="165" width="72" height="37" rx="6"/>
          <text x="313" y="220" text-anchor="middle">[1]</text><text x="389" y="220" text-anchor="middle">[2]</text>
          <text x="313" y="189" text-anchor="middle">P₃</text><text x="389" y="189" text-anchor="middle">P₄</text>
        </g>
        <path d="M240 119 V160" class="share" />
        <text x="240" y="116" text-anchor="middle" class="shared-label">shared continuous face</text>
        <text x="123" y="246" text-anchor="middle" class="strip-label">cell 1 uses P₀, P₁, P₂</text>
        <text x="351" y="246" text-anchor="middle" class="strip-label">cell 2 uses P₂, P₃, P₄</text>
      </svg>
    </section>

    <section>
      <h4>Selected 2-D hypercube · degree 2</h4>
      <svg viewBox="0 0 480 245" role="img" aria-labelledby="storage-two-title storage-two-desc">
        <title id="storage-two-title">Two-dimensional selected-cell coefficient lattice</title>
        <desc id="storage-two-desc">LocalValues indexed by cell one and cell two contains a three-by-three tensor lattice with nine degree-two labels.</desc>
        <rect x="35" y="38" width="122" height="122" class="physical-grid" />
        <line x1="96" y1="38" x2="96" y2="160" class="grid-line"/><line x1="35" y1="99" x2="157" y2="99" class="grid-line"/>
        <rect x="96" y="38" width="61" height="61" class="selected-cell" />
        <text x="96" y="190" text-anchor="middle" class="small-label">physical cells</text>
        <path d="M164 70 C190 70 190 70 211 70" class="zoom" />
        <text x="315" y="24" text-anchor="middle" class="local-title">{"LocalValues{i1}{i2}"}</text>
        <g class="lattice">
          <rect x="226" y="40" width="178" height="178" rx="7" />
          <line x1="285.3" y1="40" x2="285.3" y2="218"/><line x1="344.6" y1="40" x2="344.6" y2="218"/>
          <line x1="226" y1="99.3" x2="404" y2="99.3"/><line x1="226" y1="158.6" x2="404" y2="158.6"/>
          <g class="lattice-labels">
            <text x="255" y="73">[0,0]</text><text x="315" y="73">[0,1]</text><text x="374" y="73">[0,2]</text>
            <text x="255" y="132">[1,0]</text><text x="315" y="132">[1,1]</text><text x="374" y="132">[1,2]</text>
            <text x="255" y="191">[2,0]</text><text x="315" y="191">[2,1]</text><text x="374" y="191">[2,2]</text>
          </g>
        </g>
        <text x="315" y="239" text-anchor="middle" class="small-label">(Degree + 1)² = 9 local labels</text>
      </svg>
    </section>
  </div>
</DiagramFrame>

<style>
  .storage-views { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 3vw, 2rem); }
  section { min-width: 0; }
  h4 { margin: 0; color: var(--sl-color-text); font-size: 0.92rem; }
  svg { margin-block-start: 0.35rem; overflow: visible; }
  text { fill: var(--sl-color-text); font-family: system-ui, sans-serif; font-size: 13px; }
  .axis, .grid-line { stroke: var(--sl-color-gray-3); stroke-width: 2; }
  .physical, .physical-grid { fill: color-mix(in srgb, var(--sl-color-accent-low) 32%, transparent); stroke: var(--sl-color-gray-4); stroke-width: 1.5; }
  .physical.selected, .selected-cell { fill: color-mix(in srgb, var(--sl-color-accent) 22%, transparent); stroke: var(--sl-color-accent); stroke-width: 2.5; }
  .nodes circle { fill: var(--sl-color-text); stroke: var(--sl-color-bg); stroke-width: 2; }
  .cell-name, .local-title { font-weight: 800; }
  .coeff rect { fill: var(--sl-color-bg); stroke-width: 1.5; }
  .coeff--first rect { stroke: var(--diagram-input); }
  .coeff--second rect { stroke: var(--diagram-result); }
  .coeff--shared rect { fill: color-mix(in srgb, var(--diagram-contribution) 11%, var(--sl-color-bg)); stroke: var(--diagram-contribution); stroke-width: 2.5; }
  .coeff text { font-weight: 750; }
  .share { fill: none; stroke: var(--diagram-contribution); stroke-width: 2; stroke-dasharray: 5 4; }
  .shared-label, .global-label { fill: var(--diagram-contribution); font-size: 12px; font-weight: 750; }
  .strip-label { fill: var(--sl-color-gray-2); font-size: 11px; }
  .zoom { fill: none; stroke: var(--sl-color-accent); stroke-width: 2; stroke-dasharray: 5 4; }
  .lattice rect { fill: color-mix(in srgb, var(--sl-color-accent-low) 42%, var(--sl-color-bg)); stroke: var(--sl-color-accent); stroke-width: 2; }
  .lattice line { stroke: var(--diagram-border); stroke-width: 1.5; }
  .lattice-labels text { text-anchor: middle; font-family: "STIX Two Math", Cambria, serif; font-size: 12px; font-weight: 750; }
  .small-label { fill: var(--sl-color-gray-2); font-size: 12px; }
  @media (max-width: 720px) { .storage-views { grid-template-columns: 1fr; } }
</style>
