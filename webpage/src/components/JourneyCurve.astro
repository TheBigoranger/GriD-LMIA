<figure
  class="journey-pipeline"
  role="img"
  aria-labelledby="journey-title"
  aria-describedby="journey-desc"
>
  <figcaption id="journey-title" class="journey-title">
    PD-LMI representation, certification, solution, and feedback workflow
  </figcaption>
  <p id="journey-desc" class="journey-description">
    An irregular wave carries the LPV model through Bernstein data, a finite
    certificate, and YALMIP. YALMIP produces the solved matrix below, which
    returns to the LPV model through a feedback arc.
  </p>

  <!-- The SVG preserves the curved topology on wide screens. Text equivalents
       live in the shared figure description, so the decorative copies stay hidden. -->
  <svg class="journey-desktop" viewBox="0 0 1120 390" aria-hidden="true">
    <defs>
      <marker id="journey-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" />
      </marker>
    </defs>

    <path class="journey-wave" d="M 78 148 C 190 48, 286 194, 402 112 S 618 44, 730 138 S 914 184, 1034 84" />

    <g class="journey-node">
      <circle cx="86" cy="141" r="13" />
      <text x="86" y="104">LPV model</text>
    </g>
    <g class="journey-node">
      <circle cx="390" cy="120" r="13" />
      <text x="390" y="82">Bernstein data</text>
    </g>
    <g class="journey-node">
      <circle cx="704" cy="130" r="13" />
      <text x="704" y="92">finite certificate</text>
    </g>
    <g class="journey-node">
      <circle cx="1022" cy="91" r="13" />
      <text x="1022" y="53">YALMIP</text>
    </g>

    <path class="journey-arrow" d="M 1012 112 C 990 192, 888 228, 797 257" />
    <g class="journey-result">
      <rect x="620" y="248" width="210" height="86" rx="14" />
      <text class="journey-result__title" x="725" y="276">solved matrix</text>
      <text class="journey-result__matrix" x="725" y="312">[ P₁₁  P₁₂ ; P₂₁  P₂₂ ]</text>
    </g>
    <path class="journey-return" d="M 612 302 C 424 370, 168 354, 92 164" />
    <text class="journey-return__label" x="335" y="357">feedback to LPV model</text>
  </svg>

  <!-- Mobile is an intentional vertical rendering, not a scaled desktop SVG. -->
  <div class="journey-mobile" aria-hidden="true">
    <ol>
      <li><span>01</span><strong>LPV model</strong></li>
      <li><span>02</span><strong>Bernstein data</strong></li>
      <li><span>03</span><strong>finite certificate</strong></li>
      <li><span>04</span><strong>YALMIP</strong></li>
      <li class="journey-mobile__result"><span>05</span><strong>solved matrix</strong><code>[P₁₁ P₁₂; P₂₁ P₂₂]</code></li>
    </ol>
    <p>feedback to LPV model</p>
  </div>
</figure>

<style>
