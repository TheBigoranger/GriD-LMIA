<div class="journey-curve">
  <svg viewBox="0 0 680 440" role="img" aria-labelledby="journey-title journey-desc">
    <title id="journey-title">Closed PD-LMI modeling and synthesis workflow</title>
    <desc id="journey-desc">The LPV model becomes cell-local Bernstein data, a finite certificate, and YALMIP constraints. The solved scheduled matrices then feed back into the LPV model.</desc>
    <defs>
      <linearGradient id="journey-gradient" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="var(--diagram-input)" />
        <stop offset="1" stop-color="var(--diagram-result)" />
      </linearGradient>
      <marker id="journey-arrow" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto">
        <path d="M0 0 L9 4.5 L0 9 Z" fill="var(--diagram-result)" />
      </marker>
    </defs>

    <path class="journey-guide" d="M92 306 C138 265 166 214 228 194 S326 134 390 126 S494 88 565 94" />
    <path class="journey-return" marker-end="url(#journey-arrow)" d="M565 94 C638 164 602 274 506 300 S356 365 270 350 S150 356 92 306" />

    <g class="journey-stage">
      <circle cx="92" cy="306" r="10" />
      <g class="journey-label" transform="translate(18 326)"><rect width="150" height="42" rx="9"/><text x="75" y="27" text-anchor="middle">LPV model</text></g>
    </g>
    <g class="journey-stage">
      <circle cx="228" cy="194" r="10" />
      <g class="journey-label" transform="translate(133 218)"><rect width="190" height="58" rx="9"/><text x="95" y="23" text-anchor="middle"><tspan x="95">cell-local Bernstein</tspan><tspan x="95" dy="22">representation</tspan></text></g>
    </g>
    <g class="journey-stage">
      <circle cx="390" cy="126" r="10" />
      <g class="journey-label" transform="translate(317 151)"><rect width="146" height="42" rx="9"/><text x="73" y="27" text-anchor="middle">finite certificate</text></g>
    </g>
    <g class="journey-stage journey-stage--result">
      <circle cx="565" cy="94" r="10" />
      <g class="journey-label" transform="translate(480 25)"><rect width="170" height="42" rx="9"/><text x="85" y="27" text-anchor="middle">YALMIP / SDP solve</text></g>
    </g>
    <g class="journey-stage journey-stage--result">
      <circle cx="506" cy="300" r="10" />
      <g class="journey-label" transform="translate(445 325)"><rect width="202" height="58" rx="9"/><text x="101" y="23" text-anchor="middle"><tspan x="101">solved scheduled</tspan><tspan x="101" dy="22">matrices</tspan></text></g>
    </g>
    <g class="journey-feedback" transform="translate(238 388)">
      <rect width="205" height="36" rx="18" />
      <text x="102.5" y="24" text-anchor="middle">feedback into LPV model</text>
    </g>
  </svg>
</div>

<style>
  .journey-curve { display: grid; align-content: center; min-width: 0; }
  svg { display: block; width: 100%; height: auto; }
  .journey-guide,
  .journey-return { fill: none; stroke-linecap: round; }
  .journey-guide { stroke: url(#journey-gradient); stroke-width: 7; }
  .journey-return { stroke: var(--diagram-result); stroke-width: 4; stroke-dasharray: 9 8; }
  .journey-stage circle { fill: var(--sl-color-bg); stroke: var(--sl-color-accent); stroke-width: 5; }
  .journey-stage--result circle { stroke: var(--diagram-result); }
  .journey-label rect { fill: var(--diagram-surface); stroke: var(--diagram-border); stroke-width: 1.5; }
  .journey-label text,
  .journey-feedback text { fill: var(--sl-color-text); font-family: system-ui, sans-serif; font-size: 16px; font-weight: 750; }
  .journey-feedback rect { fill: color-mix(in srgb, var(--diagram-result) 10%, var(--sl-color-bg)); stroke: var(--diagram-result); }
</style>
