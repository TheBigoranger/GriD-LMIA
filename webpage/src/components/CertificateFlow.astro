---
import CertificateFlow from "./CertificateFlow.tsx";
import { certificateSources } from "../data/certificate-data";
import { renderMath } from "../lib/katex-renderer.js";

const { compact = false, eager = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const cardNotation = {
  direct: "\\begin{gathered}C^{(\\vect c)}[\\vect i]:\\text{ target coefficient matrix}\\\\\\vect i\\in\\mathcal I_{\\vect M}=\\prod_s\\{0,\\ldots,M_s\\}:\\text{ local label}\\end{gathered}",
  polya: "\\begin{gathered}\\tilde C^{(\\vect c)}[\\vect i]\\succeq0,\\quad\\vect i\\in\\mathcal I_{\\vect M+\\vect d}\\\\\\mathcal I_{\\vect M+\\vect d}=\\prod_{s=1}^{\\ell}\\{0,\\ldots,M_s+d_s\\}\\end{gathered}",
  putinar: "\\begin{gathered}S_0,S_s\\succeq0:\\text{ PSD Gram/SOS polynomial matrices}\\\\g_s=\\alpha_s(1-\\alpha_s):\\text{ box generator};\\quad r:\\text{ absolute Gram order}\\end{gathered}",
  sparseputinar: "\\begin{gathered}\\mathcal Q_{\\mathrm P}:\\text{ active Putinar specifications, including the 1D parity blocks}\\\\w_s=\\min(b,d_s+1):\\text{ tensor-window side}\\\\Q_{q,\\vect u}\\succeq0:\\text{ independent tensor-window block};\\quad b:\\text{ CliqueSize value}\\end{gathered}",
  sparsefullbox: "\\mathcal W_{\\vect u}:\\text{ sliding tensor-label window};\\quad Q_{J,\\vect u}:\\text{ independent PSD Gram block};\\quad w:\\text{ window side};\\quad w=1:\\text{ Direct};\\quad w\\ge\\max_s(r_s+1):\\text{ FullBox}",
  fullbox: "Z_J=\\vect b_{r\\vect 1-\\vect\\chi_J}\\otimes I_n;\\quad Q_J:\\text{ dense PSD Gram};\\quad J\\subseteq[\\ell];\\quad r:\\text{ absolute Gram order}",
} as const;
const options = certificateSources.map((item) => ({
  key: item.key,
  label: item.label,
  command: item.command,
  formulaMarkup: renderMath(item.cardFormula),
  notationMarkup: renderMath(cardNotation[item.key]),
  notationRows: item.key === "direct"
    ? [
        {
          formulaMarkup: renderMath("C^{(\\vect c)}[\\vect i]"),
          label: "target coefficient matrix",
        },
        {
          formulaMarkup: renderMath("\\vect i\\in\\mathcal I_{\\vect M}=\\prod_s\\{0,\\ldots,M_s\\}"),
          label: "local label",
        },
      ]
    : undefined,
  href: `${base}${item.detailRoute}`,
}));
const residualMarkup = renderMath("S^{(\\vect c)}(\\vect\\alpha)\\succ0");
---

{eager
  ? <CertificateFlow compact={compact} options={options} residualMarkup={residualMarkup} client:load />
  : <CertificateFlow compact={compact} options={options} residualMarkup={residualMarkup} client:visible />}
