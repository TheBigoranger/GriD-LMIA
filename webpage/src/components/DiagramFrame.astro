---
interface Props {
  caption: string;
  label?: string;
  class?: string;
}

const { caption, label = caption, class: className = "" } = Astro.props;
---

<figure class:list={["diagram-frame", className]}>
  <div class="diagram-frame__body" role="img" aria-label={label}>
    <slot />
  </div>
  <figcaption>{caption}</figcaption>
</figure>
