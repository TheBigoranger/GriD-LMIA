---
import CellStorageExplorer from "./CellStorageExplorer.tsx";
import CertificateFlow from "./CertificateFlow.astro";
import ExportSolveFlow from "./ExportSolveFlow.astro";
import GridPartitionExplorer from "./GridPartitionExplorer.tsx";
import JourneyCurve from "./JourneyCurve.astro";
import KaTeXMath from "./KaTeXMath.astro";
import { versionInfo } from "../data/version.js";
import { pdmatCellData } from "../lib/cell-bernstein.ts";
import { renderMath } from "../lib/katex-renderer.js";

const base = import.meta.env.BASE_URL;
const local = (path) => `${base.replace(/\/?$/, "/")}${path.replace(/^\/+/, "")}`;

const primaryLinks = [
  { href: local("documents/"), label: "Open manual" },
  { href: local("documents/reference-index/"), label: "Function lookup" },
  { href: local("install/"), label: "Install" },
  { href: local("examples/solver-smoke/"), label: "Solver examples" },
];

const lmiSteps = [
  {
    number: "01",
    title: "Model the general DPD-LMI problem",
    inlineMath: "\\boldsymbol y=\\bigl(y_1,\\ldots,y_N\\bigr)^\\top:\\mathcal P\\to\\mathbb R^N.",
    inlineNoteParts: [
      { tex: "\\boldsymbol y" },
      " is the decision function, assumed locally Lipschitz continuous on ",
      { tex: "\\mathcal P" },
      ".",
    ],
    math: "\\begin{aligned}&\\mathcal F(\\boldsymbol\\rho,\\dot{\\boldsymbol\\rho};y)\\\\&=\\sum_{k=1}^{N}\\sum_{s=1}^{\\ell}\\dot\\rho_sT_{k,s}(\\boldsymbol\\rho)\\\\&\\quad{}\\cdot\\frac{\\partial y_k}{\\partial\\rho_s}(\\boldsymbol\\rho)\\\\&\\quad+F_0(\\boldsymbol\\rho)\\\\&\\quad+\\sum_{k=1}^{N}F_k(\\boldsymbol\\rho)y_k(\\boldsymbol\\rho)\\preceq0.\\end{aligned}",
    manual: "documents/math/modeling-and-analysis/dpd-lmi-and-lpv-l2-gain/",
    manualLabel: "Open the induced-L₂-gain specialization ↗",
  },
  {
    number: "02",
    title: "Partition the supported parameter box",
    textParts: [
      "Axis ", { tex: "s" }, " uses ", { tex: "k_s" }, " physical nodes in ",
      { tex: "\\mathcal G_s" }, "; the one-based vector ", { tex: "\\mathbf c" },
      " selects ", { tex: "\\mathcal H_{\\mathbf c}" },
      ". The tensor grid partitions ", { tex: "\\mathcal P" },
      " exactly. Approximation comes only from restricting the decision-function space; affine rate-vertex reduction remains exact.",
    ],
    math: [
      "\\begin{aligned}\\mathcal P&=\\prod_{s=1}^{\\ell}[\\underline\\rho_s,\\overline\\rho_s],\\\\\\mathcal R&=\\prod_{s=1}^{\\ell}[\\underline\\nu_s,\\overline\\nu_s].\\end{aligned}",
      "\\mathcal G_s=\\{\\rho_s^{(1)},\\ldots,\\rho_s^{(k_s)}\\}.",
      "\\begin{aligned}\\mathcal H_{\\mathbf c}&=\\prod_{s=1}^{\\ell}[\\rho_s^{(c_s)},\\rho_s^{(c_s+1)}].\\end{aligned}",
    ],
    mathLabels: [
      ["axis-", { tex: "s" }, " physical nodes"],
      ["physical cell selected by ", { tex: "\\mathbf c" }],
    ],
    visual: "grid",
    manual: "documents/math/gridding-and-degree/",
    fullCode: "grid = {[0 0.4 1], [0 0.25 1]};\nA = pdmat(grid, @(r1,r2) [1+r1+r2 r1*r2; r1*r2 2+r1^2], Degree=[2 2]);",
  },
  {
    number: "03",
    title: "Fix one cell and use the Bernstein basis",
    textParts: [
      "Pull one physical cell back to ", { tex: "\\boldsymbol\\alpha\\in[0,1]^\\ell" },
      ". The normalized basis is nonnegative and sums to one, exposes endpoint and face coefficients, and supports cell-local coefficient algebra.",
    ],
    math: [
      "\\boldsymbol\\alpha=\\phi_{\\mathbf c}^{-1}(\\boldsymbol\\rho),\\qquad\\alpha_s=\\frac{\\rho_s-\\rho_s^{(c_s)}}{h_s^{\\mathbf c}}.",
      "B_{\\mathbf i}^{\\mathbf m}(\\boldsymbol\\alpha)=\\prod_{s=1}^{\\ell}\\binom{m_s}{i_s}\\alpha_s^{i_s}(1-\\alpha_s)^{m_s-i_s},\\qquad\\sum_{\\mathbf i}B_{\\mathbf i}^{\\mathbf m}(\\boldsymbol\\alpha)=1.",
      "A^{(\\mathbf c)}(\\boldsymbol\\alpha)=\\sum_{\\mathbf i}C^{(\\mathbf c)}[\\mathbf i]B_{\\mathbf i}^{\\mathbf m}(\\boldsymbol\\alpha).",
    ],
    storageMath: "\\begin{gathered}A(\\rho_1,\\rho_2)=\\\\\\begin{bmatrix}1+\\rho_1+\\rho_2&\\rho_1\\rho_2\\\\\\rho_1\\rho_2&2+\\rho_1^2\\end{bmatrix}.\\end{gathered}",
    visual: "storage",
    fullCode: "grid = {[0 0.5 1], [0 1]};\nA = pdmat(grid, @(r1,r2) [1+r1+r2 r1*r2; r1*r2 2+r1^2], Degree=[2 2]);\nA.cells()\nA.LocalValues{1}{1}",
    manual: "documents/math/coordinates-and-bernstein/coefficient-algebra/",
  },
  {
    number: "04",
    title: "Select a finite certificate for the positive target",
    textParts: [
      "The theoretical cell target is ", { tex: "S^{(\\mathbf c)}(\\boldsymbol\\alpha)\\succ0" },
      ". YALMIP uses non-strict semidefinite constraints, so a required numerical margin must be written explicitly as ",
      { tex: "S^{(\\mathbf c)}-\\varepsilon I\\succeq0" },
      ". Expand any method below to see one representative identity, its notation, the MATLAB selector, and the detailed reference.",
    ],
    math: [
      "S^{(\\mathbf c)}(\\boldsymbol\\alpha)=-\\mathcal F^{(\\mathbf c)}(\\boldsymbol\\alpha)\\succ0.",
    ],
    visual: "certificate",
    fullCode: "selected = L;  % or select Pólya, Putinar, SparseFullBox, or FullBox",
    manual: "documents/math/finite-certificates/direct-and-polya/",
  },
  {
    number: "05",
    title: "Assemble the panorama, solve, and validate status",
    text: "Combine known pdmat data with pdvar decisions, optional cellwise rhodiff terms, a residual comparison, and the selected finite certificate. Export to YALMIP, solve, require sol.problem == 0, and only then recover decisions or objectives.",
    math: "\\texttt{toYalmip}\\;\\longrightarrow\\;\\texttt{optimize}\\;\\longrightarrow\\;\\texttt{value(P)}",
    visual: "export",
    fullCode: "yalmip('clear')\nP = pdvar(n, grid, \"symmetric\", Degree=[2 2]);\nD = rhodiff(P, rateBounds);                 % optional rate term\nL = D + P*A + A'*P <= -epsilon*eye(n);     % residual comparison\nselected = L;                              % Direct by default\nsol = optimize(selected.toYalmip(), objective, options);\nif sol.problem == 0\n    Psol = value(P);\n    gammaSol = value(gamma);\nend",
    manual: "documents/reference/pdlmi/toyalmip/",
  },
];

const storageAxisTex = {
  x: ["\\rho_2^{(1)}", "\\rho_2^{(2)}"],
  y: ["\\rho_1^{(1)}", "\\rho_1^{(2)}", "\\rho_1^{(3)}"],
};
const storageMathMarkup = {
  formula: renderMath(lmiSteps[2].storageMath, { displayMode: true }),
  basis: renderMath("\\begin{aligned}B_{\\mathbf i}^{m}(\\boldsymbol\\alpha)&=\\prod_{s=1}^{\\ell}\\binom{m}{i_s}\\\\&\\quad{}\\cdot\\alpha_s^{i_s}\\\\&\\quad{}\\cdot(1-\\alpha_s)^{m-i_s}\\end{aligned}", { displayMode: true }),
  axis: {
    x: storageAxisTex.x.map((tex) => renderMath(tex)),
    y: storageAxisTex.y.map((tex) => renderMath(tex)),
  },
  cells: pdmatCellData.map((cell) => ({
    selection: renderMath(`c=(${cell.c1},1)`),
    domain: renderMath(cell.domainTex),
    button: renderMath(`c_1=${cell.c1}`),
    coefficients: cell.coefficients.map((coefficient, index) => ({
      label: renderMath(`C^{(${cell.c1},1)}_{${Math.floor(index / 3)},${index % 3}}`),
      value: renderMath(coefficient.tex),
    })),
    bernstein: renderMath(`A^{(${cell.c1},1)}(\\boldsymbol\\alpha)=\\sum_{\\mathbf i\\in\\{0,1,2\\}^{\\ell}}C_{\\mathbf i}^{(${cell.c1},1)}B_{\\mathbf i}^{2}(\\boldsymbol\\alpha)`, { displayMode: true }),
  })),
};

---

<div class="home-portal">
  <section class="home-hero" aria-label="PD-LMI welcome portal">
    <div class="home-copy">
      <p class="home-kicker">MATLAB / YALMIP</p>
      <p class="home-wordmark">PD-LMI</p>
      <p class="home-subtitle">From a continuum DPD-LMI to finite cellwise certificates.</p>
      <p class="home-summary">
        Model general symmetric residual inequalities with continuous
        piecewise-polynomial decisions, optional exact scheduling-rate vertex
        reduction, cell-local Bernstein algebra, and five selectable finite
        certificate states.
      </p>
      <nav class="home-actions" aria-label="Primary documentation links">
        {primaryLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>
    <JourneyCurve />
  </section>

  <section class="product-walkthrough" aria-labelledby="walkthrough-title">
    <header class="section-heading">
      <p class="home-label">Worked spine · {versionInfo.current}</p>
      <h2 id="walkthrough-title">From a continuum DPD-LMI to YALMIP and recovered decisions</h2>
      <p>Follow one notation-stable spine. Each stage links to a focused mathematical guide and the relevant API reference.</p>
    </header>

    <div class="lmi-narrative">
      {lmiSteps.map((step) => (
        <section class="lmi-step">
          <div class="step-number" aria-hidden="true">{step.number}</div>
          <div class="step-content">
            <div class="step-copy">
              <h3>{step.title}{step.titleMath && <KaTeXMath class="step-title-math" tex={step.titleMath} />}{step.titleSuffix}</h3>
              {step.visual !== "grid" && (step.textParts
                ? <p>{step.textParts.map((part) => typeof part === "string" ? part : <KaTeXMath tex={part.tex} />)}</p>
                : step.text ? <p>{step.text}</p> : null)}
              {step.visual === "storage"
                ? <div class="cell-storage-compact"><CellStorageExplorer client:load mathMarkup={storageMathMarkup} /></div>
                : step.visual === "grid"
                  ? <>
                      <div class="math-strip">
                        {(Array.isArray(step.math) ? step.math.slice(0, 1) : [step.math]).map((line) => (
                          <KaTeXMath class="math-strip__row" display tex={line} />
                        ))}
                      </div>
                      {step.textParts
                        ? <p>{step.textParts.map((part) => typeof part === "string" ? part : <KaTeXMath tex={part.tex} />)}</p>
                        : step.text ? <p>{step.text}</p> : null}
                      <div class:list={["math-strip", { "math-strip--annotated": step.mathLabels }]}>
                        {(Array.isArray(step.math) ? step.math.slice(1) : []).map((line, index) => (
                          step.mathLabels
                            ? <div class="math-strip__annotated-row">
                                <p class="math-strip__label">
                                  {step.mathLabels[index].map((part) =>
                                    typeof part === "string" ? part : <KaTeXMath tex={part.tex} />)}
                                </p>
                                <KaTeXMath class="math-strip__row" display tex={line} />
                              </div>
                            : <KaTeXMath class="math-strip__row" display tex={line} />
                        ))}
                      </div>
                      <GridPartitionExplorer client:load />
                    </>
                : step.visual === "export"
                  ? <ExportSolveFlow />
                : <div class:list={["math-strip", { "math-strip--stacked": Array.isArray(step.math) }]}>
                    {(Array.isArray(step.math) ? step.math : [step.math]).map((line) => (
                      <KaTeXMath class="math-strip__row" display tex={line} />
                    ))}
                  </div>}
              {step.inlineMath && <KaTeXMath class="step-inline-math" tex={step.inlineMath} />}
              {step.inlineNoteParts && <p class="step-inline-note">{step.inlineNoteParts.map((part) => typeof part === "string" ? part : <KaTeXMath tex={part.tex} />)}</p>}
              {step.visual === "certificate" && <CertificateFlow compact eager />}
              {step.fullCode && <div class="example-disclosure"><pre class="example-disclosure__essential"><code>{step.fullCode}</code></pre></div>}
              {step.manual && <a class="manual-step-link" href={local(step.manual)}>{step.manualLabel ?? "Open the detailed manual section ↗"}</a>}
            </div>
          </div>
        </section>
      ))}
    </div>

  </section>

  <section class="download-panel">
    <div><p class="home-label">Source and manual</p><h2>Use the synchronized {versionInfo.current} documentation.</h2><p>The printable manual and online reference use the same terminology, worked example, and API boundary.</p></div>
    <nav class="download-links" aria-label="Download links">
      <a href="https://github.com/TheBigoranger/PD-LMI-package">Current source</a>
      <a href={local("manual.pdf")}>Printable manual</a>
      <a href={local("version-history/")}>Version history</a>
    </nav>
  </section>
</div>

<style>
  :global(.sl-container) { max-width: 1180px; }
  :global(.sl-markdown-content) { max-width: none; }
  :global(.sl-markdown-content > .home-portal) { margin-block: -1rem 2rem; }

  .home-portal { display: grid; gap: clamp(2rem, 4vw, 3.2rem); }
  .home-hero,
  .download-panel { border: 1px solid var(--diagram-border); border-radius: 22px; background: var(--diagram-surface); box-shadow: 0 20px 50px rgb(15 23 42 / 0.08); }
  .home-hero { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(1.6rem, 3vw, 2.4rem); padding: clamp(1.3rem, 3.5vw, 2.8rem); }
  .home-hero :global(.journey-pipeline) { inline-size: min(100%, 62rem); margin-inline: auto; }
  .home-copy { display: grid; align-content: center; gap: 0.9rem; min-width: 0; max-width: 72ch; }
  .home-kicker,
  .home-label { margin: 0; color: var(--sl-color-text-accent); font-size: 0.78rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .home-wordmark { margin: 0; font-size: clamp(3.7rem, 10vw, 7.4rem); font-weight: 900; line-height: 0.88; }
  .home-subtitle { margin: 0; font-size: clamp(1.25rem, 2.5vw, 1.9rem); font-weight: 750; line-height: 1.2; }
  .home-summary,
  .section-heading > p:not(.home-label),
  .download-panel p { max-width: 68ch; margin: 0; color: var(--sl-color-gray-2); line-height: 1.65; }
  .home-actions,
  .download-links { display: flex; flex-wrap: wrap; gap: 0.65rem; }
  .home-actions a,
  .download-links a { border: 1px solid var(--diagram-border); border-radius: 999px; padding: 0.68rem 0.9rem; color: var(--sl-color-text); text-decoration: none; background: var(--sl-color-bg); font-weight: 700; }
  .home-actions a:first-child { color: white; border-color: transparent; background: linear-gradient(135deg, var(--diagram-input), var(--diagram-result)); }

  .product-walkthrough { display: grid; gap: 1.2rem; }
  .section-heading { display: grid; gap: 0.45rem; }
  .section-heading h2,
  .download-panel h2 { margin: 0; font-size: clamp(1.5rem, 3vw, 2.2rem); line-height: 1.12; }
  .lmi-step { display: grid; grid-template-columns: 3.2rem minmax(0, 1fr); gap: 1rem; padding-block: 1.35rem; border-block-start: 1px solid var(--diagram-border); }
  .step-number { color: var(--sl-color-text-accent); font-size: 2rem; font-weight: 900; }
  .step-content,
  .step-copy { display: grid; gap: 0.75rem; min-width: 0; }
  .step-copy h3,
  .step-copy p { margin: 0; }
  .step-inline-math { min-width: 0; padding-block: 0.15rem; }
  .step-inline-note { margin-top: 0.35rem; color: var(--sl-color-gray-2); }
  .cell-storage-compact :global(.cell-explorer) { gap: 0.65rem; }
  .cell-storage-compact :global(.diagram-frame__body) { padding: 0.65rem; }
  .cell-storage-compact :global(.cell-coeffs) { gap: 0.25rem; }
  .cell-storage-compact :global(.cell-coeffs > span) { padding: 0.35rem 0.2rem; }
  .cell-storage-compact :global(.cell-explorer__formula) { display: grid; gap: 0.35rem; padding: 0.75rem 1rem 0.2rem; text-align: center; }
  .cell-storage-compact :global(.cell-explorer__formula .formula-display) { margin: 0; }
  .cell-storage-compact :global(.cell-grid-panel) { display: grid; gap: 0.35rem; min-width: 0; }
  .cell-storage-compact :global(.cell-grid-stage__formula) { justify-self: center; width: 100%; max-width: 100%; padding-block-end: 0.1rem; text-align: center; }
  .cell-storage-compact :global(.cell-grid-stage__formula .formula-display) { margin: 0; }
  .cell-storage-compact :global(.cell-grid-stage) { grid-template-columns: 2rem minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) auto; gap: 0.2rem; }
  .cell-storage-compact :global(.cell-axis-y-wrap) { display: grid; grid-column: 1; grid-row: 1; grid-template-columns: 1fr; align-items: stretch; }
  .cell-storage-compact :global(.cell-axis-ticks) { color: var(--sl-color-gray-2); font-family: "STIX Two Math", Cambria, serif; font-size: 1.15rem; font-weight: 750; }
  .cell-storage-compact :global(.cell-axis-ticks--y) { display: grid; align-content: space-between; justify-items: end; padding-block: 0.2rem; }
  .cell-storage-compact :global(.cell-axis-ticks--x) { display: flex; grid-column: 2; grid-row: 2; justify-content: space-between; padding-inline: 0.15rem; }
  .cell-storage-compact :global(.cell-grid) { grid-column: 2; grid-row: 1; aspect-ratio: 1 / 1.8; }
  .cell-storage-compact :global(.cell-axis) { font-size: 1.25rem; font-weight: 400; }
  .cell-storage-compact :global(.cell-grid button) { font-size: 0.95rem; font-weight: 520; }
  .cell-storage-compact :global(.cell-grid button.selected) { font-weight: 750; }
  .cell-storage-compact :global(.cell-coeffs > span) { min-height: 3.65rem; gap: 0.08rem; padding: 0.45rem 0.18rem; border-radius: 5px; }
  .cell-storage-compact :global(.cell-coeffs > span > small) { font-size: clamp(0.78rem, 0.68rem + 0.5vw, 0.98rem); line-height: 1.05; }
  .cell-storage-compact :global(.cell-coeff-math) { line-height: 1.05; margin-block-start: -0.12rem; }
  .cell-storage-compact :global(.cell-storage-connector) { z-index: 2; min-width: 0; white-space: nowrap; overflow: visible; font-size: 0.9rem; }
  .cell-storage-compact :global(.cell-readout) { padding-inline-start: 0.45rem; }
  @media (min-width: 701px) {
    .cell-storage-compact :global(.cell-explorer) { inline-size: min(100%, 66rem); margin-inline: auto; gap: 0.85rem; }
    .cell-storage-compact :global(.cell-grid-stage) { inline-size: min(100%, 9.5rem); justify-self: center; }
    .cell-storage-compact :global(.cell-coeffs) { inline-size: 100%; max-inline-size: 100%; justify-self: stretch; }
  }
  .step-copy p { color: var(--sl-color-gray-2); line-height: 1.65; }
  .math-strip { display: grid; inline-size: min(100%, 54rem); min-width: 0; margin-inline: auto; border-inline-start: 3px solid var(--sl-color-accent); padding-inline-start: 0.8rem; font-size: clamp(0.72rem, 0.63rem + 0.45vw, 1rem); }
  /* Ordinary mathematics is authored as short or multiline displays. */
  .math-strip__row { min-width: 0; }
  .math-strip--annotated { gap: clamp(0.65rem, 1.5vw, 1rem); }
  .math-strip__annotated-row { display: grid; min-width: 0; gap: 0.2rem; }
  .math-strip__label { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.15rem; margin: 0; color: var(--sl-color-gray-2); font-size: clamp(0.74rem, 0.7rem + 0.2vw, 0.88rem); font-weight: 700; line-height: 1.35; }
  .math-strip__annotated-row :global(.formula-display) { margin: 0; text-align: start; }
  .math-strip :global(.formula-display),
  .math-strip :global(.katex-display) { margin: 0; }
  .step-content :global(.diagram-frame) { margin-block: 0.4rem 0; }
  .step-content :global(.certificate-flow) { inline-size: min(100%, 54rem); margin-inline: auto; }
  .step-content :global(.export-solve-flow) { inline-size: min(100%, 58rem); margin-inline: auto; }
  .example-disclosure { min-width: 0; }
  .example-disclosure pre { margin: 0; min-width: 0; overflow-x: auto; }
  .example-disclosure__essential { border-inline-start: 3px solid var(--sl-color-accent); }
  .manual-step-link { width: fit-content; color: var(--sl-color-text-accent); font-size: 0.88rem; font-weight: 750; text-decoration: none; }
  .manual-step-link:hover { text-decoration: underline; }


  .download-panel { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; align-items: center; padding: 1.2rem; }
  .download-panel > div { display: grid; gap: 0.45rem; }
  .download-links { justify-content: flex-end; }

  @media (max-width: 820px) {
    .home-hero,
    .download-panel { grid-template-columns: 1fr; }
    .download-links { justify-content: flex-start; }

    .cell-storage-compact :global(.cell-summary),
    .cell-storage-compact :global(.cell-layout) { grid-template-columns: minmax(0, 1fr); }
    .cell-storage-compact :global(.cell-transform-arrow),
    .cell-storage-compact :global(.cell-storage-connector) { width: auto; height: 2.5rem; justify-self: center; }
    .cell-storage-compact :global(.cell-transform-arrow i),
    .cell-storage-compact :global(.cell-storage-connector i) {
      width: 0;
      height: 1.2rem;
      justify-self: center;
      border-block-start: 0;
      border-inline-start: 2px solid var(--sl-color-accent);
    }
    .cell-storage-compact :global(.cell-transform-arrow i::after),
    .cell-storage-compact :global(.cell-storage-connector i::after) {
      inset-block-start: auto;
      inset-block-end: -1px;
      inset-inline-start: -5px;
      inset-inline-end: auto;
      border-block-start: 0;
      border-inline-end: 2px solid var(--sl-color-accent);
      border-block-end: 2px solid var(--sl-color-accent);
      transform: rotate(45deg);
    }
  }

  @media (max-width: 820px) {
    .lmi-step { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .step-number { font-size: 1.45rem; }
  }

  @media (max-width: 700px) {
    .cell-storage-compact :global(.cell-grid-stage) { inline-size: min(100%, 14rem); justify-self: center; }
    .cell-storage-compact :global(.cell-coeffs) { inline-size: 100%; max-inline-size: 100%; justify-self: stretch; }
  }

  @media (max-width: 390px) {
    .home-hero,
    .download-panel { border-radius: 16px; padding: 0.85rem; }
    .home-actions a,
    .download-links a { width: 100%; text-align: center; }
  }
</style>
