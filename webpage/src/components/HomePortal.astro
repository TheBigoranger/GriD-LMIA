---
import KaTeXMath from "./KaTeXMath.astro";

const base = import.meta.env.BASE_URL;
const local = (path: string) => `${base.replace(/\/?$/, "/")}${path.replace(/^\/+/, "")}`;

const targetTex = String.raw`\mathcal F(\vect\rho,\dot{\vect\rho};\vect y)=F_0(\vect\rho)+\sum_{k=1}^{N}F_k(\vect\rho)y_k(\vect\rho)+\sum_{k=1}^{N}\sum_{s=1}^{\ell}\dot\rho_s F_{k,s}(\vect\rho)\frac{\partial y_k}{\partial\rho_s}(\vect\rho)\preceq0,\quad\forall(\vect\rho,\dot{\vect\rho})\in\mathcal P\times\mathcal R.`;

const primaryLinks = [
  { key: "reference", href: local("documents/#reference"), label: "Reference" },
  { key: "learn", href: local("documents/#learn"), label: "Learn" },
  { key: "examples", href: local("examples/"), label: "Examples" },
  { key: "install", href: local("install/"), label: "Install" },
];

const workflow = [
  { key: "model", title: "Model the DPD-LMI", href: local("documents/math/modeling-and-analysis/dpd-lmi-and-lpv-l2-gain/#general-dpd-lmi-template") },
  { key: "grid", title: "Partition the parameter box", href: local("documents/math/gridding-and-degree/") },
  { key: "bernstein", title: "Build Bernstein data", href: local("documents/math/coordinates-and-bernstein/coefficient-algebra/") },
  { key: "certificate", title: "Select a certificate", href: local("documents/math/sos-certificates/#certificate-map") },
  { key: "solve", title: "Assemble and solve with YALMIP", href: local("documents/math/modeling-and-analysis/dpd-lmi-and-lpv-l2-gain/#modeling-path-in-matlab") },
];

const citation = "Yicheng Xu and Faryar Jabbari, “GriD-LMIA: A Gridding-Based Assembler for Solving Differentiable Parameter-Dependent Linear Matrix Inequalities,” arXiv:2608.03175, 2026.";
const bibtex = String.raw`@article{xu2026gridlmia,
  title         = {GriD-LMIA: A Gridding-Based Assembler for Solving Differentiable Parameter-Dependent Linear Matrix Inequalities},
  author        = {Xu, Yicheng and Jabbari, Faryar},
  year          = {2026},
  eprint        = {2608.03175},
  archivePrefix = {arXiv}
}`;
---

<section class="welcome" aria-labelledby="welcome-title">
  <header class="welcome-hero">
    <p class="welcome-platform">MATLAB / YALMIP</p>
    <h1 id="welcome-title">GriD-LMIA</h1>
    <p class="welcome-subtitle">Gridding-based parameter-dependent LMI assembly for MATLAB and YALMIP</p>
    <p class="welcome-summary">Model and solve parameter-dependent LMIs over tensor grids using Bernstein polynomial data and rigorous finite certificates.</p>

    <figure class="welcome-target" aria-labelledby="welcome-target-caption">
      <figcaption id="welcome-target-caption">General DPD-LMI target</figcaption>
      <KaTeXMath class="welcome-target__math formula-block formula-one-line" tex={targetTex} display />
    </figure>

    <nav class="welcome-actions" aria-label="Primary documentation links">
      {primaryLinks.map((link, index) => (
        <a class:list={["welcome-action", { "welcome-action--primary": index === 0 }]} href={link.href}>
          <svg aria-hidden="true" viewBox="0 0 24 24">
            {link.key === "reference" && <><path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H11v17H7.5A3.5 3.5 0 0 0 4 22Z"/><path d="M20 5.5A3.5 3.5 0 0 0 16.5 2H13v17h3.5A3.5 3.5 0 0 1 20 22Z"/></>}
            {link.key === "learn" && <><path d="m3 9 9-5 9 5-9 5Z"/><path d="M7 12.5V17c2.8 2.2 7.2 2.2 10 0v-4.5"/></>}
            {link.key === "examples" && <><path d="m8 6-4 6 4 6"/><path d="m16 6 4 6-4 6"/><path d="m14 3-4 18"/></>}
            {link.key === "install" && <><path d="M12 3v12"/><path d="m7.5 10.5 4.5 4.5 4.5-4.5"/><path d="M4 17v4h16v-4"/></>}
          </svg>
          <span>{link.label}</span>
        </a>
      ))}
    </nav>
  </header>

  <ol class="welcome-workflow" aria-label="GriD-LMIA workflow">
    {workflow.map((step, index) => (
      <li>
        <a class="workflow-step" href={step.href}>
          <span class="workflow-heading">
            <span class="workflow-number" aria-hidden="true">{index + 1}</span>
            <span>{step.title}</span>
          </span>
          <span class="workflow-visual" aria-hidden="true">
            {step.key === "model" && (
              <svg viewBox="0 0 180 190">
                <path class="diagram-line diagram-strong" d="M45 18h62l28 28v111H45Z"/><path class="diagram-line" d="M107 18v28h28M62 66h56M62 82h45M62 111h56M62 127h42"/>
                <rect class="diagram-accent" x="61" y="91" width="57" height="29" rx="5"/><text class="diagram-label" x="90" y="111">LMI</text><text class="diagram-math" x="90" y="181">𝓕 ≼ 0</text>
              </svg>
            )}
            {step.key === "grid" && (
              <svg viewBox="0 0 180 190">
                <g class="diagram-line diagram-grid"><path d="M38 50h104v95H38ZM72.7 50v95M107.3 50v95M38 81.7h104M38 113.3h104"/><path d="m38 50 18-19h104l-18 19M142 50l18-19v95l-18 19M72.7 50l18-19M107.3 50l18-19M142 81.7l18-19M142 113.3l18-19"/></g>
                <g class="diagram-node"><circle cx="38" cy="50" r="4"/><circle cx="72.7" cy="50" r="4"/><circle cx="107.3" cy="50" r="4"/><circle cx="142" cy="50" r="4"/><circle cx="38" cy="81.7" r="4"/><circle cx="72.7" cy="81.7" r="4"/><circle cx="107.3" cy="81.7" r="4"/><circle cx="142" cy="81.7" r="4"/><circle cx="38" cy="113.3" r="4"/><circle cx="72.7" cy="113.3" r="4"/><circle cx="107.3" cy="113.3" r="4"/><circle cx="142" cy="113.3" r="4"/><circle cx="38" cy="145" r="4"/><circle cx="72.7" cy="145" r="4"/><circle cx="107.3" cy="145" r="4"/><circle cx="142" cy="145" r="4"/></g>
                <text class="diagram-math" x="90" y="181">ρ ∈ 𝒫</text>
              </svg>
            )}
            {step.key === "bernstein" && (
              <svg viewBox="0 0 180 190">
                <g class="diagram-line diagram-dashed"><path d="m90 27-57 122h114ZM90 27v122M61 88h58M33 149l57-61 57 61"/></g>
                <g class="diagram-node diagram-node--teal"><circle cx="90" cy="27" r="8"/><circle cx="61" cy="88" r="8"/><circle cx="90" cy="88" r="8"/><circle cx="119" cy="88" r="8"/><circle cx="33" cy="149" r="8"/><circle cx="61" cy="149" r="8"/><circle cx="90" cy="149" r="8"/><circle cx="119" cy="149" r="8"/><circle cx="147" cy="149" r="8"/></g><text class="diagram-math" x="90" y="181">Bᵢ</text>
              </svg>
            )}
            {step.key === "certificate" && (
              <svg viewBox="0 0 180 190">
                <ellipse class="diagram-line diagram-teal" cx="90" cy="48" rx="58" ry="17"/><path class="diagram-line diagram-teal" d="M32 48 90 151 148 48"/><path class="diagram-line diagram-dashed diagram-teal" d="M90 151v20"/><text class="certificate-symbol" x="90" y="101">Σ</text><text class="diagram-caption" x="90" y="181">certificate</text>
              </svg>
            )}
            {step.key === "solve" && (
              <svg viewBox="0 0 180 190">
                <rect class="diagram-line diagram-strong diagram-teal" x="25" y="35" width="130" height="105" rx="8"/><path class="diagram-line diagram-teal" d="M25 59h130"/><circle class="diagram-dot" cx="38" cy="47" r="3"/><circle class="diagram-dot" cx="49" cy="47" r="3"/><circle class="diagram-dot" cx="60" cy="47" r="3"/><path class="diagram-line" d="m44 80 10 8-10 8M66 88h28M44 112h75M44 125h58"/><circle class="diagram-line diagram-teal" cx="129" cy="92" r="14"/><path class="diagram-line diagram-teal" d="m122 92 5 5 10-12"/><text class="diagram-caption" x="90" y="171">YALMIP solver</text>
              </svg>
            )}
          </span>
        </a>
        {index < workflow.length - 1 && <svg class="workflow-arrow" aria-hidden="true" viewBox="0 0 40 24"><path d="M3 12h30m-8-8 8 8-8 8"/></svg>}
      </li>
    ))}
  </ol>

  <section class="welcome-info" aria-labelledby="welcome-info-title">
    <header class="welcome-info__header">
      <p>Project information</p>
      <h2 id="welcome-info-title">Authors, updates, and citation</h2>
    </header>

    <div class="welcome-info__stream">
      <article class="welcome-info__item">
        <h3>Author and maintainer</h3>
        <p>Created and maintained by Yicheng Xu.</p>
        <a href={local("about/")}>About GriD-LMIA <span aria-hidden="true">→</span></a>
      </article>

      <hr class="welcome-info__separator" />

      <article class="welcome-info__item">
        <h3>Latest in v1.4.1</h3>
        <ul>
          <li>pdlmi constraint concatenation</li>
          <li>Seven source-grounded examples</li>
          <li>Source/publish build boundary</li>
          <li>194 public API records</li>
        </ul>
        <a href={local("version-history/")}>Full version history <span aria-hidden="true">→</span></a>
      </article>

      <hr class="welcome-info__separator" />

      <article class="welcome-info__item">
        <h3>Cite GriD-LMIA</h3>
        <p class="citation-label" id="citation-plain-label">Plain text</p>
        <pre class="citation-code" aria-labelledby="citation-plain-label" tabindex="0"><code>{citation}</code></pre>
        <p class="citation-label" id="citation-bibtex-label">BibTeX</p>
        <pre class="citation-code citation-code--bibtex" aria-labelledby="citation-bibtex-label" tabindex="0"><code>{bibtex}</code></pre>
        <a href={local("citing/")}>Citation details <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>
</section>

<style>
  :global(.sl-container) { max-width: 96rem; }
  :global(.sl-markdown-content) { max-width: none; }
  :global(main:has(.welcome) > .content-panel:first-child) { display:none; }
  :global(.sl-markdown-content > .welcome) { margin-block:0 1rem; }
  .welcome { --welcome-accent:#075be8; --welcome-teal:#0a918f; --welcome-ink:#06183c; --welcome-muted:#33466d; --welcome-line:#cbd8eb; --welcome-surface:#fff; overflow:hidden; border:2px solid var(--welcome-accent); border-radius:22px; padding:clamp(1.25rem,2vw,2rem); color:var(--welcome-ink); background:var(--welcome-surface); }
  .welcome-hero { padding-block-end:clamp(1.1rem,1.8vw,1.55rem); border-block-end:1px solid var(--welcome-line); }
  .welcome-platform { margin:0 0 .45rem; color:var(--welcome-accent); font-size:clamp(.82rem,1vw,1rem); font-weight:800; letter-spacing:.09em; }
  .welcome h1 { margin:0; color:var(--welcome-ink); font-size:clamp(3.25rem,6vw,5.8rem); font-weight:850; letter-spacing:-.055em; line-height:.98; }
  .welcome-subtitle { max-width:70rem; margin:clamp(.65rem,1.2vw,.9rem) 0 0; color:var(--welcome-ink); font-size:clamp(1.12rem,1.75vw,1.55rem); font-weight:750; line-height:1.25; }
  .welcome-summary { max-width:50rem; margin:clamp(.6rem,1vw,.8rem) 0 0; color:var(--welcome-muted); font-size:clamp(.96rem,1.2vw,1.1rem); line-height:1.5; }
  .welcome-target { max-width:100%; margin:clamp(.7rem,1.2vw,.95rem) 0 0; overflow-x:auto; overscroll-behavior-inline:contain; }
  .welcome-target figcaption { margin:0; color:var(--welcome-muted); font-size:.78rem; font-weight:800; letter-spacing:.06em; text-align:center; text-transform:uppercase; }
  :global(.welcome-target__math.formula-display) { width:max-content; min-width:100%; max-width:none; padding-block:.1rem; }
  .welcome-actions { display:flex; flex-wrap:wrap; gap:.75rem 1.15rem; margin-block-start:clamp(.9rem,1.5vw,1.2rem); }
  .welcome-action { display:inline-flex; min-width:9.25rem; align-items:center; justify-content:center; gap:.6rem; border:2px solid var(--welcome-accent); border-radius:7px; padding:.68rem 1.1rem; color:var(--welcome-accent); background:var(--welcome-surface); font-size:.95rem; font-weight:750; line-height:1; text-decoration:none; transition:border-color 160ms ease,box-shadow 160ms ease,transform 160ms ease; }
  .welcome-action svg { width:1.5rem; fill:none; stroke:currentColor; stroke-linecap:round; stroke-linejoin:round; stroke-width:1.8; }
  .welcome-action--primary { border-color:transparent; color:white; background:linear-gradient(120deg,#075be8 0%,#0872d7 56%,#0aa4a0 100%); }
  .welcome-action:hover { border-color:var(--welcome-teal); box-shadow:0 8px 22px rgb(7 91 232 / .13); transform:translateY(-2px); }
  .welcome-action:focus-visible,.workflow-step:focus-visible,.welcome-info a:focus-visible { outline:3px solid color-mix(in srgb,var(--welcome-accent) 35%,white); outline-offset:4px; }
  .welcome-workflow { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:clamp(1.15rem,2.6vw,2.4rem); margin:0; padding:clamp(1rem,1.7vw,1.4rem) 0 0; list-style:none; }
  .welcome-workflow > li { position:relative; min-width:0; }
  .workflow-step { display:grid; height:100%; min-width:0; grid-template-rows:auto minmax(7.5rem,1fr); gap:.4rem; border-radius:12px; padding:.35rem; color:var(--welcome-ink); text-decoration:none; transition:background 160ms ease,transform 160ms ease; }
  .workflow-step:hover { background:#f5f9ff; transform:translateY(-3px); }
  .workflow-heading { display:grid; grid-template-columns:2rem minmax(0,1fr); gap:.6rem; align-items:start; min-height:2.8rem; font-size:clamp(.82rem,.95vw,.95rem); font-weight:800; line-height:1.24; }
  .workflow-number { display:grid; width:2rem; height:2rem; place-items:center; border-radius:50%; color:white; background:var(--welcome-accent); font-weight:850; }
  .workflow-visual { display:grid; min-width:0; place-items:center; }
  .workflow-visual > svg { width:min(100%,8.3rem); height:auto; overflow:visible; }
  .diagram-line { fill:none; stroke:var(--welcome-ink); stroke-linecap:round; stroke-linejoin:round; stroke-width:2.1; }
  .diagram-strong { stroke-width:2.5; } .diagram-grid { stroke:#1682d0; stroke-width:1.35; } .diagram-dashed { stroke-dasharray:5 5; } .diagram-teal { stroke:var(--welcome-teal); }
  .diagram-accent { fill:#f6f9ff; stroke:var(--welcome-ink); stroke-width:2; } .diagram-node { fill:#fff; stroke:var(--welcome-accent); stroke-width:2; } .diagram-node--teal { stroke:var(--welcome-teal); } .diagram-dot { fill:var(--welcome-teal); }
  .diagram-label,.diagram-math,.diagram-caption,.certificate-symbol { fill:var(--welcome-ink); text-anchor:middle; }
  .diagram-label { font:800 18px/1 system-ui,sans-serif; letter-spacing:.08em; } .diagram-math { font:italic 16px/1 Georgia,serif; } .diagram-caption { font:600 14px/1 system-ui,sans-serif; } .certificate-symbol { font:38px/1 Georgia,serif; }
  .workflow-arrow { position:absolute; z-index:1; inset-block-start:58%; inset-inline-end:calc(clamp(1.15rem,2.6vw,2.4rem) * -.82); width:clamp(1.5rem,2.4vw,2.5rem); fill:none; stroke:var(--welcome-accent); stroke-linecap:round; stroke-linejoin:round; stroke-width:2.5; pointer-events:none; }
  .welcome-info { margin-block-start:clamp(1rem,1.7vw,1.4rem); border-block-start:1px solid var(--welcome-line); padding-block-start:clamp(1rem,1.7vw,1.35rem); }
  .welcome-info__header { margin-block-end:.75rem; }
  .welcome-info__header p { margin:0; color:var(--welcome-accent); font-size:.74rem; font-weight:850; letter-spacing:.08em; text-transform:uppercase; }
  .welcome-info h2 { margin:.25rem 0 0; color:var(--welcome-ink); font-size:clamp(1.05rem,1.4vw,1.3rem); line-height:1.25; }
  .welcome-info__stream { display:flex; flex-direction:column; }
  .welcome-info__item { min-width:0; padding-block:1.35rem; }
  .welcome-info__item:first-child { padding-block-start:1.45rem; }
  .welcome-info__separator { width:100%; margin:0; border:0; border-block-start:1px solid var(--welcome-line); }
  .welcome-info__item h3 { margin:0 0 .45rem; color:var(--welcome-ink); font-size:1rem; line-height:1.3; }
  .welcome-info__item p { margin:.35rem 0; color:var(--welcome-muted); font-size:.9rem; line-height:1.45; }
  .welcome-info__item ul { margin:.3rem 0 .55rem; padding-inline-start:1.1rem; color:var(--welcome-muted); font-size:.88rem; line-height:1.45; }
  .welcome-info__item li + li { margin-block-start:.18rem; }
  .welcome-info__item a { display:inline-flex; align-items:center; gap:.25rem; margin-block-start:.25rem; color:var(--welcome-accent); font-size:.86rem; font-weight:750; text-decoration:none; }
  .welcome-info__item a:hover { color:var(--welcome-teal); text-decoration:underline; }
  .welcome-info__item .citation-label { margin:.25rem 0 .2rem; color:var(--welcome-ink); font-size:.72rem; font-weight:800; letter-spacing:.05em; text-transform:uppercase; }
  .citation-code { box-sizing:border-box; max-width:100%; margin:0 0 .45rem; overflow-x:auto; overscroll-behavior-inline:contain; border:1px solid #d7e1ef; border-radius:6px; padding:.55rem .65rem; color:var(--welcome-ink); background:#f6f9ff; font-size:.74rem; line-height:1.4; white-space:pre; }
  .citation-code--bibtex { max-height:8.2rem; }
  @media (max-width:1050px) { .welcome-workflow { grid-template-columns:repeat(2,minmax(0,1fr)); } .welcome-workflow > li:last-child { grid-column:1/-1; width:min(50%,22rem); justify-self:center; } .workflow-arrow { display:none; } }
  @media (max-width:620px) { :global(.sl-markdown-content > .welcome) { margin-inline:-.25rem; } .welcome { border-radius:16px; padding:1.15rem; } .welcome h1 { font-size:clamp(2.8rem,18vw,4.4rem); } .welcome-actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.7rem; } .welcome-action { min-width:0; padding-inline:.75rem; } .welcome-workflow { grid-template-columns:minmax(0,1fr); gap:.85rem; } .welcome-workflow > li:last-child { grid-column:auto; width:100%; } .workflow-step { grid-template-columns:minmax(0,1fr); grid-template-rows:auto auto; justify-items:center; border-block-start:1px solid var(--welcome-line); border-radius:0; padding-block:1rem; } .workflow-heading { width:100%; min-height:0; } .workflow-heading > span:last-child { overflow-wrap:normal; word-break:normal; hyphens:none; } .workflow-visual { grid-column:1; grid-row:2; } .workflow-visual > svg { width:min(100%,8.5rem); } }
  @media (prefers-reduced-motion:reduce) { .welcome-action,.workflow-step { transition:none; } }
</style>
