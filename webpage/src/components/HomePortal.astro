---
import PdmatStorageDiagram from "./PdmatStorageDiagram.astro";
import WorkflowStepDiagram from "./WorkflowStepDiagram.astro";
import { mathjax } from "mathjax-full/js/mathjax.js";
import { liteAdaptor } from "mathjax-full/js/adaptors/liteAdaptor.js";
import { RegisterHTMLHandler } from "mathjax-full/js/handlers/html.js";
import { TeX } from "mathjax-full/js/input/tex.js";
import { SVG } from "mathjax-full/js/output/svg.js";
import "mathjax-full/js/input/tex/ams/AmsConfiguration.js";

const base = import.meta.env.BASE_URL;

const local = (path) => `${base.replace(/\/?$/, "/")}${path.replace(/^\/+/, "")}`;

const adaptor = liteAdaptor();
RegisterHTMLHandler(adaptor);

const tex = new TeX({ packages: ["base", "ams"] });
const svg = new SVG({ fontCache: "none" });
const mathDoc = mathjax.document("", { InputJax: tex, OutputJax: svg });

const renderDisplayMath = (src) =>
  adaptor.outerHTML(mathDoc.convert(src, { display: true }));

const primaryLinks = [
  { href: local("documents/"), label: "Open manual" },
  { href: local("documents/reference-index/"), label: "Function lookup" },
  { href: local("install/"), label: "Install" },
  { href: local("examples/solver-smoke/"), label: "Solver examples" },
];

const manualLinks = [
  {
    href: local("documents/reference-index/"),
    title: "Lookup by name",
    text: "Find implemented classes, constructors, methods, and solver-facing tasks.",
  },
  {
    href: local("documents/math/bernstein-polynomial/"),
    title: "Bernstein model",
    text: "Read how cell-local coefficients, labels, and degree growth support matrix inequalities.",
  },
  {
    href: local("documents/reference/pdlmi/toyalmip/"),
    title: "YALMIP handoff",
    text: "See how coefficient-wise constraints become YALMIP constraints for ordinary solvers.",
  },
  {
    href: local("examples/solver-smoke/"),
    title: "Runnable examples",
    text: "Start from small workflows backed by the repository test suite.",
  },
  {
    href: local("documents/reference/pdlmi/"),
    title: "Choose a certificate",
    text: "Compare direct, Pólya, and full-box assembly, then follow the matching API page.",
  },
];

const downloadLinks = [
  {
    href: "https://github.com/TheBigoranger/DP-LMI-package",
    label: "Current source",
  },
  {
    href: local("manual.pdf"),
    label: "Current manual snapshot",
  },
  { href: local("install/"), label: "Setup notes" },
  { href: local("version-history/"), label: "Version history" },
];

const lmiSteps = [
  {
    number: "01",
    title: "General DP-LMI",
    text:
      "Known matrices R_i(rho) and F_i(rho), differentiable decision functions x_i(rho), and a rate box for rho_dot define a continuous matrix inequality. If the derivative term is absent, the same expression is an ordinary parameter-dependent LMI.",
    math:
      "\\mathcal{G}=\\sum_i R_i(\\rho)\\bigl(\\nabla_\\rho x_i\\cdot\\dot\\rho\\bigr)+F_0(\\rho)+\\sum_iF_i(\\rho)x_i(\\rho)\\prec0.",
    kind: null,
    code: null,
    output: null,
  },
  {
    number: "02",
    title: "Store known data and decisions cell by cell",
    text:
      "Physical-node subscripts identify only grid nodes. A cell has its own identity c, and bracketed labels [i] identify local Bernstein coefficients. pdmat stores known data; pdvar creates decision matrices on the same grid.",
    math:
      "M_c(\\alpha)=\\sum_{i=0}^{m}B_i^m(\\alpha)\\,C^{(c)}[i],\\qquad \\alpha=\\frac{\\rho-\\rho_{c-1}}{\\rho_c-\\rho_{c-1}}.",
    kind: "store",
    code: "grid = {[0 1]};\nA = pdmat(grid, @(rho) [1 rho; rho 2], Degree=1);\nP = pdvar(2, grid, \"symmetric\");\n[A.ncell(), A.ncoeff(), P.Degree]",
    output: "ans =\n     1     2     1",
  },
  {
    number: "03",
    title: "Build the differential residual",
    text:
      "Matrix products are exact Bernstein coefficient convolutions, not products of a few samples. rhodiff forms physical forward differences and creates a separate row for every rate-box vertex.",
    math:
      "R^{(c)}[k]=\\sum_{i+j=k}\\frac{\\binom mi\\binom nj}{\\binom{m+n}{k}}P^{(c)}[i]A^{(c)}[j].",
    kind: "assemble",
    code: "D = rhodiff(P, [-1 1]);\nresidual = D + P*A + A'*P;\n[size(D.coeffs(1),1), residual.Degree]",
    output: "ans =\n     2     2",
  },
  {
    number: "04",
    title: "Certify, solve, and inspect",
    text:
      "A comparison constructs pdlmi and uses the direct coefficient certificate by default. toYalmip exports the finite constraints; ordinary YALMIP selects the solver. Opt-in Pólya and full-box choices change the certificate, not the stored residual.",
    math:
      "R^{(c)}[k]\\preceq0\\;\\forall(c,k,\\dot\\rho_v)\\quad\\Longrightarrow\\quad R(\\rho,\\dot\\rho)\\preceq0.",
    kind: "solve",
    code: "C = residual <= -1e-6*eye(2);\nF = C.toYalmip();\nsol = optimize(F, [], sdpsettings('verbose',0));\nsol.problem",
    output: "ans =\n     0",
  },
];
---

<div class="home-portal">
  <section class="home-hero" aria-label="DP-LMI welcome portal">
    <div class="home-copy">
      <p class="home-wordmark">DP-LMI</p>
      <p class="home-subtitle">
        Differential parameter-dependent LMIs for MATLAB/YALMIP.
      </p>
      <p class="home-summary">
        Represent parameter-dependent matrices cell by cell, keep Bernstein
        coefficients close to the local grid geometry, and assemble
        solver-facing constraints for SDP solvers.
      </p>
      <nav class="home-actions" aria-label="Primary documentation links">
        {primaryLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>

    <aside class="lpv-visual" aria-label="LPV system to DP-LMI solver diagram">
      <svg viewBox="0 0 620 420" role="img" aria-labelledby="lpv-title lpv-desc">
        <title id="lpv-title">LPV system diagram for DP-LMI</title>
        <desc id="lpv-desc">
          Parameter trajectories and rate bounds feed an LPV system, DP-LMI
          constraints, and a YALMIP SDP handoff.
        </desc>
        <defs>
          <marker id="lpv-arrow" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto">
            <path d="M1 1 L8 4.5 L1 8 Z" class="lpv-arrow-head" />
          </marker>
          <linearGradient id="lpv-card" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" class="lpv-card-start" />
            <stop offset="100%" class="lpv-card-end" />
          </linearGradient>
          <linearGradient id="lpv-accent" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#2563eb" />
            <stop offset="100%" stop-color="#0f766e" />
          </linearGradient>
        </defs>

        <rect x="28" y="34" width="564" height="348" rx="30" class="lpv-shell" />
        <text x="66" y="78" class="lpv-annotation">rho(t)</text>
        <text x="424" y="78" class="lpv-annotation">rho_dot bounds</text>
        <path d="M70 126 C122 72 190 74 242 120 S364 176 428 118 S526 92 558 132" class="lpv-curve" />
        <circle cx="102" cy="108" r="6" class="lpv-dot" />
        <circle cx="242" cy="120" r="6" class="lpv-dot" />
        <circle cx="428" cy="118" r="6" class="lpv-dot" />

        <g class="lpv-block">
          <rect x="62" y="180" width="220" height="96" rx="22" />
          <text x="90" y="214">LPV dynamics</text>
          <text x="90" y="242" class="lpv-detail">x' = A(rho)x + B(rho)u</text>
        </g>
        <g class="lpv-block emphasis">
          <rect x="356" y="160" width="190" height="118" rx="24" />
          <text x="390" y="196">DP-LMI</text>
          <text x="390" y="226" class="lpv-detail">P(rho), dP/dt</text>
          <text x="390" y="252" class="lpv-detail">cell-local Bernstein</text>
        </g>
        <g class="lpv-block solver">
          <rect x="226" y="314" width="176" height="54" rx="20" />
          <text x="258" y="348">YALMIP / SDP</text>
        </g>

        <path d="M282 228 H334" class="lpv-link" />
        <path d="M462 278 C454 306 424 330 402 340" class="lpv-link" />
        <path d="M154 276 C164 312 198 336 226 342" class="lpv-link muted" />
        <path d="M458 108 V146" class="lpv-link muted" />
      </svg>
    </aside>
  </section>

  <section class="product-walkthrough" aria-labelledby="product-title">
    <div class="section-heading">
      <p class="home-label">From PD-LMI to Bernstein storage</p>
      <h2 id="product-title">Start from the inequality, then represent it cell by cell.</h2>
      <p>
        Follow one model from its continuous inequality to stored matrix
        coefficients, a differential residual, and ordinary YALMIP solver
        calls. Each stage keeps the formula, MATLAB operation, output, and
        geometry together.
      </p>
    </div>

    <div class="lmi-narrative" aria-label="DP-LMI modeling steps">
      {
        lmiSteps.map((step) => (
          <section class:list={["lmi-step", { illustrated: step.kind }]}>
            <div class="step-number" aria-hidden="true">{step.number}</div>
            <div class="step-content">
              <div class="step-copy">
                <h3>{step.title}</h3>
                <p>{step.text}</p>
                <div class="math-strip" set:html={renderDisplayMath(step.math)} />
                {step.code && (
                  <div class="step-example" aria-label={`${step.title} MATLAB example and output`}>
                    <pre><code>{step.code}</code></pre>
                    <pre class="step-output"><code>{step.output}</code></pre>
                  </div>
                )}
              </div>
              {step.kind && <WorkflowStepDiagram kind={step.kind} />}
            </div>
          </section>
        ))
      }
    </div>

    <div class="formula-panel" aria-label="A concrete Bernstein matrix product">
      <div>
        <strong>Local coordinate</strong>
        <p>
          <code>rho_k: physical node only</code>
          <code>c: physical cell</code>
          <code>[i]: local coefficient label</code>
        </p>
      </div>
      <div>
        <strong>Product coefficients</strong>
        <p>
          <code>R^(c)[0] = P^(c)[0] * Q^(c)[0]</code>
          <code>R^(c)[1] = (P^(c)[0] * Q^(c)[1] + P^(c)[1] * Q^(c)[0]) / 2</code>
          <code>R^(c)[2] = P^(c)[1] * Q^(c)[1]</code>
        </p>
      </div>
    </div>

    <PdmatStorageDiagram />
  </section>

  <section class="home-grid" aria-labelledby="manual-title">
    <div class="section-heading">
      <p class="home-label">Manual entrances</p>
      <h2 id="manual-title">Jump into the online manual.</h2>
    </div>
    <div class="manual-entry-list">
      {
        manualLinks.map((link) => (
          <a href={link.href}>
            <strong>{link.title}</strong>
            <span>{link.text}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="download-panel" aria-labelledby="download-title">
    <div>
      <p class="home-label">Download and install</p>
      <h2 id="download-title">Use the current source package and manual.</h2>
      <p>
        Use the current repository source together with the printable manual.
        Setup notes show the recursive MATLAB path, and version history records
        the published manual releases without inventing a source tag.
      </p>
    </div>
    <nav class="download-strip" aria-label="Download links">
      {downloadLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </section>

  <section class="status-strip" aria-label="Main package entry points">
    <strong>Modeling path</strong>
    <span><code>pdbase</code> storage</span>
    <span><code>pdmat</code> known data</span>
    <span><code>pdvar</code> decisions</span>
    <span><code>rhodiff</code> rate rows</span>
    <span><code>pdlmi</code> YALMIP assembly</span>
    <a href={local("documents/reference-index/")}>Look up an API</a>
  </section>
</div>

<style>
  :global(.sl-container) {
    max-width: 1180px;
  }

  :global(.sl-markdown-content) {
    max-width: none;
  }

  :global(.sl-markdown-content > .home-portal) {
    margin-block: -1rem 2rem;
  }

  .home-portal {
    --home-border: rgb(148 163 184 / 0.28);
    --home-border-accent: rgb(96 165 250 / 0.3);
    --home-surface: rgb(255 255 255 / 0.62);
    --home-surface-soft: rgb(255 255 255 / 0.54);
    --home-surface-control: rgb(255 255 255 / 0.68);
    --home-hero-start: rgb(255 255 255 / 0.78);
    --home-hero-end: rgb(255 255 255 / 0.42);
    --home-highlight: rgb(255 255 255 / 0.78);
    --home-shadow: rgb(15 23 42 / 0.12);
    --home-diagram-start: rgb(255 255 255 / 0.92);
    --home-diagram-end: rgb(219 234 254 / 0.58);
    --home-diagram-panel-start: rgb(255 255 255 / 0.72);
    --home-diagram-panel-end: rgb(219 234 254 / 0.44);
    --home-diagram-block: rgb(255 255 255 / 0.8);
    --home-diagram-emphasis: rgb(239 246 255 / 0.9);
    --home-diagram-solver: rgb(15 118 110 / 0.1);
    --home-diagram-text: #0f172a;
    --home-diagram-detail: #334155;
    position: relative;
    isolation: isolate;
    display: grid;
    gap: clamp(2rem, 4vw, 3.4rem);
    color: var(--sl-color-text);
  }

  :global([data-theme="dark"]) .home-portal {
    --home-border: rgb(148 163 184 / 0.24);
    --home-border-accent: rgb(96 165 250 / 0.38);
    --home-surface: rgb(15 23 42 / 0.82);
    --home-surface-soft: rgb(15 23 42 / 0.72);
    --home-surface-control: rgb(30 41 59 / 0.88);
    --home-hero-start: rgb(15 23 42 / 0.92);
    --home-hero-end: rgb(15 23 42 / 0.74);
    --home-highlight: rgb(148 163 184 / 0.2);
    --home-shadow: rgb(0 0 0 / 0.34);
    --home-diagram-start: rgb(30 41 59 / 0.96);
    --home-diagram-end: rgb(30 58 95 / 0.82);
    --home-diagram-panel-start: rgb(15 23 42 / 0.9);
    --home-diagram-panel-end: rgb(23 52 74 / 0.82);
    --home-diagram-block: rgb(30 41 59 / 0.94);
    --home-diagram-emphasis: rgb(30 58 95 / 0.94);
    --home-diagram-solver: rgb(15 118 110 / 0.28);
    --home-diagram-text: #f8fafc;
    --home-diagram-detail: #cbd5e1;
  }

  /* Match the system palette during the brief auto-theme state on mobile. */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .home-portal {
      --home-border: rgb(148 163 184 / 0.24);
      --home-border-accent: rgb(96 165 250 / 0.38);
      --home-surface: rgb(15 23 42 / 0.82);
      --home-surface-soft: rgb(15 23 42 / 0.72);
      --home-surface-control: rgb(30 41 59 / 0.88);
      --home-hero-start: rgb(15 23 42 / 0.92);
      --home-hero-end: rgb(15 23 42 / 0.74);
      --home-highlight: rgb(148 163 184 / 0.2);
      --home-shadow: rgb(0 0 0 / 0.34);
      --home-diagram-start: rgb(30 41 59 / 0.96);
      --home-diagram-end: rgb(30 58 95 / 0.82);
      --home-diagram-panel-start: rgb(15 23 42 / 0.9);
      --home-diagram-panel-end: rgb(23 52 74 / 0.82);
      --home-diagram-block: rgb(30 41 59 / 0.94);
      --home-diagram-emphasis: rgb(30 58 95 / 0.94);
      --home-diagram-solver: rgb(15 118 110 / 0.28);
      --home-diagram-text: #f8fafc;
      --home-diagram-detail: #cbd5e1;
    }
  }

  .home-portal::before {
    content: "";
    position: absolute;
    inset: -5rem -2.5rem -3rem;
    z-index: -1;
    border-radius: 34px;
    background:
      linear-gradient(115deg, color-mix(in srgb, #2563eb 18%, transparent), transparent 44%),
      linear-gradient(245deg, color-mix(in srgb, #14b8a6 18%, transparent), transparent 52%),
      conic-gradient(from 220deg at 72% 14%, rgb(37 99 235 / 0.18), rgb(15 118 110 / 0.16), rgb(124 58 237 / 0.12), rgb(37 99 235 / 0.18)),
      linear-gradient(180deg, color-mix(in srgb, var(--sl-color-bg) 94%, #e0f2fe), color-mix(in srgb, var(--sl-color-bg) 96%, #ecfeff));
    background-size: 150% 150%, 130% 130%, 140% 140%, auto;
    box-shadow: inset 0 1px 0 var(--home-highlight);
    opacity: 0.92;
  }

  .home-portal::after {
    content: "";
    position: absolute;
    inset: -5rem -2.5rem -3rem;
    z-index: -1;
    border-radius: 34px;
    background:
      linear-gradient(90deg, rgb(37 99 235 / 0.055) 1px, transparent 1px),
      linear-gradient(180deg, rgb(15 118 110 / 0.045) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(180deg, black, rgb(0 0 0 / 0.68), transparent);
  }

  @supports (animation-timeline: scroll()) {
    .home-portal::before {
      animation: portal-gradient-shift linear both;
      animation-timeline: scroll(root block);
    }

    @keyframes portal-gradient-shift {
      from {
        background-position: 0% 0%, 100% 0%, 50% 0%, 0 0;
      }

      to {
        background-position: 26% 18%, 72% 28%, 38% 46%, 0 0;
      }
    }
  }

  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(22rem, 0.82fr);
    gap: clamp(1.6rem, 4vw, 3rem);
    align-items: stretch;
    min-height: 28rem;
    padding: clamp(1.35rem, 3.4vw, 3rem);
    border: 1px solid var(--home-border-accent);
    border-radius: 28px;
    background:
      linear-gradient(135deg, var(--home-hero-start), var(--home-hero-end)),
      linear-gradient(180deg, color-mix(in srgb, var(--sl-color-bg) 96%, #dbeafe), color-mix(in srgb, var(--sl-color-bg) 90%, #ccfbf1));
    box-shadow:
      0 24px 70px var(--home-shadow),
      inset 0 1px 0 var(--home-highlight);
    overflow: hidden;
  }

  .home-copy {
    display: grid;
    align-content: center;
    gap: 1.1rem;
    min-width: 0;
  }

  .home-wordmark {
    margin: 0;
    color: var(--sl-color-text);
    font-size: clamp(4rem, 11vw, 8.4rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.9;
  }

  .home-subtitle {
    max-width: 32ch;
    margin: 0;
    color: var(--sl-color-text);
    font-size: clamp(1.25rem, 2.6vw, 2rem);
    font-weight: 750;
    line-height: 1.16;
  }

  .home-label {
    margin: 0;
    color: var(--sl-color-text-accent);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .section-heading h2,
  .download-panel h2 {
    margin: 0;
    color: var(--sl-color-text);
    letter-spacing: 0;
  }

  .home-summary,
  .section-heading p:not(.home-label),
  .download-panel p {
    max-width: 66ch;
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 1.04rem;
    line-height: 1.65;
  }

  .home-actions,
  .download-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    align-items: center;
  }

  .home-actions a,
  .download-strip a {
    border: 1px solid var(--home-border);
    border-radius: 999px;
    padding: 0.78rem 1rem;
    color: var(--sl-color-text);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    background: var(--home-surface-control);
    box-shadow:
      0 12px 30px var(--home-shadow),
      inset 0 1px 0 var(--home-highlight);
    backdrop-filter: blur(12px);
  }

  .home-actions a:first-child {
    color: white;
    border-color: transparent;
    background: linear-gradient(135deg, #2563eb, #0f766e);
    box-shadow: 0 18px 36px rgb(37 99 235 / 0.22);
  }

  .lpv-visual {
    display: grid;
    align-items: center;
    min-width: 0;
    border-radius: 26px;
    background:
      linear-gradient(145deg, var(--home-diagram-panel-start), var(--home-diagram-panel-end)),
      linear-gradient(180deg, var(--home-surface-soft), transparent);
    box-shadow:
      0 20px 50px var(--home-shadow),
      inset 0 1px 0 var(--home-highlight);
    transform: perspective(1000px) rotateY(-3deg) rotateX(1deg);
  }

  .lpv-visual svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .lpv-shell {
    fill: url("#lpv-card");
    stroke: rgb(37 99 235 / 0.18);
    stroke-width: 1.2;
  }

  .lpv-card-start {
    stop-color: var(--home-diagram-start);
  }

  .lpv-card-end {
    stop-color: var(--home-diagram-end);
  }

  .lpv-curve {
    fill: none;
    stroke: url("#lpv-accent");
    stroke-width: 4.5;
    stroke-linecap: round;
  }

  .lpv-dot {
    fill: #2563eb;
    stroke: white;
    stroke-width: 3;
  }

  .lpv-annotation,
  .lpv-block text {
    fill: var(--home-diagram-text);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-size: 18px;
    font-weight: 760;
  }

  .lpv-annotation {
    fill: var(--home-diagram-detail);
    font-size: 15px;
    font-weight: 800;
  }

  .lpv-block rect {
    fill: var(--home-diagram-block);
    stroke: rgb(30 64 175 / 0.18);
    stroke-width: 1.2;
    filter: drop-shadow(0 12px 18px var(--home-shadow));
  }

  .lpv-block text + text {
    fill: var(--home-diagram-detail);
    font-size: 13px;
    font-weight: 650;
  }

  .lpv-detail {
    font-size: 13px;
  }

  .lpv-block.emphasis rect {
    fill: var(--home-diagram-emphasis);
    stroke: rgb(37 99 235 / 0.36);
  }

  .lpv-block.solver rect {
    fill: var(--home-diagram-solver);
    stroke: rgb(15 118 110 / 0.28);
  }

  .lpv-link {
    fill: none;
    stroke: #2563eb;
    stroke-width: 3;
    stroke-linecap: round;
    marker-end: url("#lpv-arrow");
  }

  .lpv-link.muted {
    stroke: #0f766e;
    stroke-width: 2.5;
  }

  .lpv-arrow-head {
    fill: currentColor;
    color: #2563eb;
  }

  .product-walkthrough {
    display: grid;
    gap: 1.35rem;
    padding: clamp(1rem, 2.4vw, 1.6rem);
    border: 1px solid var(--home-border);
    border-radius: 24px;
    background: var(--home-surface);
    box-shadow: 0 18px 52px var(--home-shadow);
    backdrop-filter: blur(14px);
  }

