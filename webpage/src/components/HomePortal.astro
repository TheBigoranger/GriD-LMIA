---
import DpmatStorageDiagram from "./DpmatStorageDiagram.astro";
import { mathjax } from "mathjax-full/js/mathjax.js";
import { liteAdaptor } from "mathjax-full/js/adaptors/liteAdaptor.js";
import { RegisterHTMLHandler } from "mathjax-full/js/handlers/html.js";
import { TeX } from "mathjax-full/js/input/tex.js";
import { SVG } from "mathjax-full/js/output/svg.js";
import "mathjax-full/js/input/tex/ams/AmsConfiguration.js";

const base = import.meta.env.BASE_URL;

const local = (path) => `${base.replace(/\/?$/, "/")}${path.replace(/^\/+/, "")}`;

const adaptor = liteAdaptor();
RegisterHTMLHandler(adaptor);

const tex = new TeX({ packages: ["base", "ams"] });
const svg = new SVG({ fontCache: "none" });
const mathDoc = mathjax.document("", { InputJax: tex, OutputJax: svg });

const renderDisplayMath = (src) =>
  adaptor.outerHTML(mathDoc.convert(src, { display: true }));

const primaryLinks = [
  { href: local("documents/"), label: "Open manual" },
  { href: local("documents/reference-index/"), label: "Function lookup" },
  { href: local("install/"), label: "Install" },
  { href: local("examples/solver-smoke/"), label: "Solver examples" },
];

const manualLinks = [
  {
    href: local("documents/reference-index/"),
    title: "Lookup by name",
    text: "Find implemented classes, constructors, methods, and solver-facing tasks.",
  },
  {
    href: local("documents/math/bernstein-polynomial/"),
    title: "Bernstein model",
    text: "Read how cell-local coefficients, labels, and degree growth support matrix inequalities.",
  },
  {
    href: local("documents/reference/dplmi/toyalmip/"),
    title: "YALMIP handoff",
    text: "See how coefficient-wise constraints become YALMIP constraints for ordinary solvers.",
  },
  {
    href: local("examples/solver-smoke/"),
    title: "Runnable examples",
    text: "Start from small workflows backed by the repository test suite.",
  },
  {
    href: local("documents/status-and-limits/"),
    title: "Status and limits",
    text: "Separate implemented coefficient assembly from reserved relaxation and diagnostic layers.",
  },
];

const downloadLinks = [
  {
    href: "https://github.com/TheBigoranger/DP-LMI-package/releases/tag/v0.2.0",
    label: "v0.2.0 release",
  },
  {
    href: "https://github.com/TheBigoranger/DP-LMI-package/archive/refs/tags/v0.2.0.zip",
    label: "v0.2.0 source ZIP",
  },
  {
    href: "https://github.com/TheBigoranger/DP-LMI-package/raw/main/doc/manual.pdf",
    label: "Current manual snapshot",
  },
  { href: local("install/"), label: "Setup notes" },
  { href: local("version-history/"), label: "Version history" },
];

const lmiSteps = [
  {
    number: "01",
    title: "General DP-LMI",
    text:
      "The reference problem is not tied to one Lyapunov inequality. It starts from parameter-dependent decision functions x_i(rho), coefficient matrices R_i(rho), F_i(rho), and a rate set for rho_dot. The goal is to certify the matrix inequality on the continuous domain Theta x Phi.",
    math:
      "\\mathcal{G}=\\sum_i R_i(\\rho)\\bigl(\\nabla_\\rho x_i\\cdot\\dot\\rho\\bigr)+F_0(\\rho)+\\sum_iF_i(\\rho)x_i(\\rho)\\prec0.",
  },
  {
    number: "02",
    title: "Represent each matrix polynomial exactly on its cell",
    text:
      "On a grid cell, the physical parameter rho is mapped to the package's reversed local coordinate alpha. When Bernstein coefficient evidence is present, known matrices and YALMIP-backed decision expressions are represented exactly by those coefficients; inspection and constraint assembly use the same local geometry.",
    math:
      "\\begin{aligned}\\rho\\in[\\rho_i,\\rho_{i+1}],\\qquad \\alpha&=\\frac{\\rho_{i+1}-\\rho}{\\rho_{i+1}-\\rho_i},\\\\M(\\rho)=M_i(\\alpha)&=\\sum_{k=0}^{d} B_{k,d}(\\alpha)\\,M_{i,k}.\\end{aligned}",
  },
  {
    number: "03",
    title: "Reduce products to finite coefficient operations",
    text:
      "Multiplication raises the Bernstein degree, but it does not change the cell where the data belongs. The package keeps the new coefficients in the same LocalValues block and hands the resulting finite SDP constraints to YALMIP.",
    math:
      "\\begin{aligned}P(\\alpha)Q(\\alpha)&=\\sum_{s=0}^{m+n} B_{s,m+n}(\\alpha)\\,R_s,\\\\R_s&=\\sum_{i+j=s} \\frac{\\binom{m}{i}\\binom{n}{j}}{\\binom{m+n}{s}}\\,P_iQ_j.\\end{aligned}",
  },
];
---

<div class="home-portal">
  <section class="home-hero" aria-label="DP-LMI welcome portal">
    <div class="home-copy">
      <p class="home-wordmark">DP-LMI</p>
      <p class="home-subtitle">
        Differential parameter-dependent LMIs for MATLAB/YALMIP.
      </p>
      <p class="home-summary">
        Represent parameter-dependent matrices cell by cell, keep Bernstein
        coefficients close to the local grid geometry, and assemble
        solver-facing constraints for SDP solvers.
      </p>
      <nav class="home-actions" aria-label="Primary documentation links">
        {primaryLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>

    <aside class="lpv-visual" aria-label="LPV system to DP-LMI solver diagram">
      <svg viewBox="0 0 620 420" role="img" aria-labelledby="lpv-title lpv-desc">
        <title id="lpv-title">LPV system diagram for DP-LMI</title>
        <desc id="lpv-desc">
          Parameter trajectories and rate bounds feed an LPV system, DP-LMI
          constraints, and a YALMIP SDP handoff.
        </desc>
        <defs>
          <marker id="lpv-arrow" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto">
            <path d="M1 1 L8 4.5 L1 8 Z" class="lpv-arrow-head" />
          </marker>
          <linearGradient id="lpv-card" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.92" />
            <stop offset="100%" stop-color="#dbeafe" stop-opacity="0.58" />
          </linearGradient>
          <linearGradient id="lpv-accent" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#2563eb" />
            <stop offset="100%" stop-color="#0f766e" />
          </linearGradient>
        </defs>

        <rect x="28" y="34" width="564" height="348" rx="30" class="lpv-shell" />
        <text x="66" y="78" class="lpv-annotation">rho(t)</text>
        <text x="424" y="78" class="lpv-annotation">rho_dot bounds</text>
        <path d="M70 126 C122 72 190 74 242 120 S364 176 428 118 S526 92 558 132" class="lpv-curve" />
        <circle cx="102" cy="108" r="6" class="lpv-dot" />
        <circle cx="242" cy="120" r="6" class="lpv-dot" />
        <circle cx="428" cy="118" r="6" class="lpv-dot" />

        <g class="lpv-block">
          <rect x="62" y="180" width="220" height="96" rx="22" />
          <text x="90" y="214">LPV dynamics</text>
          <text x="90" y="242" class="lpv-detail">x' = A(rho)x + B(rho)u</text>
        </g>
        <g class="lpv-block emphasis">
          <rect x="356" y="160" width="190" height="118" rx="24" />
          <text x="390" y="196">DP-LMI</text>
          <text x="390" y="226" class="lpv-detail">P(rho), dP/dt</text>
          <text x="390" y="252" class="lpv-detail">cell-local Bernstein</text>
        </g>
        <g class="lpv-block solver">
          <rect x="226" y="314" width="176" height="54" rx="20" />
          <text x="258" y="348">YALMIP / SDP</text>
        </g>

        <path d="M282 228 H334" class="lpv-link" />
        <path d="M462 278 C454 306 424 330 402 340" class="lpv-link" />
        <path d="M154 276 C164 312 198 336 226 342" class="lpv-link muted" />
        <path d="M458 108 V146" class="lpv-link muted" />
      </svg>
    </aside>
  </section>

  <section class="product-walkthrough" aria-labelledby="product-title">
    <div class="section-heading">
      <p class="home-label">From PD-LMI to Bernstein storage</p>
      <h2 id="product-title">Start from the inequality, then represent it cell by cell.</h2>
      <p>
        The package turns a differential parameter-dependent LMI into finite
        sufficient coefficient constraints. The local Bernstein picture below
        is the exact coefficient-storage mechanism behind that solver-facing
        assembly when coefficient evidence is available.
      </p>
    </div>

    <div class="lmi-narrative" aria-label="DP-LMI modeling steps">
      {
        lmiSteps.map((step) => (
          <section class="lmi-step">
            <div class="step-number" aria-hidden="true">{step.number}</div>
            <div class="step-copy">
              <h3>{step.title}</h3>
              <p>{step.text}</p>
              <div class="math-strip" set:html={renderDisplayMath(step.math)} />
            </div>
          </section>
        ))
      }
    </div>

    <div class="formula-panel" aria-label="Bernstein product coefficient formulas">
      <div>
        <strong>Local coordinate</strong>
        <p>
          <code>rho in [rho_i, rho_i_plus_1]</code>
          <code>alpha = (rho_i_plus_1 - rho) / (rho_i_plus_1 - rho_i)</code>
          <code>label 0 = left; label m = right</code>
        </p>
      </div>
      <div>
        <strong>Product coefficients</strong>
        <p>
          <code>R0 = P0 * Q0</code>
          <code>R1 = (P0 * Q1 + P1 * Q0) / 2</code>
          <code>R2 = P1 * Q1</code>
        </p>
      </div>
    </div>

    <DpmatStorageDiagram />
  </section>

  <section class="home-grid" aria-labelledby="manual-title">
    <div class="section-heading">
      <p class="home-label">Manual entrances</p>
      <h2 id="manual-title">Jump into the online manual.</h2>
    </div>
    <div class="manual-entry-list">
      {
        manualLinks.map((link) => (
          <a href={link.href}>
            <strong>{link.title}</strong>
            <span>{link.text}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="download-panel" aria-labelledby="download-title">
    <div>
      <p class="home-label">Download and install</p>
      <h2 id="download-title">Use the current source package and manual.</h2>
      <p>
        Start from the tagged v0.2.0 release or its immutable source archive.
        The PDF link follows the current manual snapshot on <code>main</code>;
        setup notes and version history explain the local installation path.
      </p>
    </div>
    <nav class="download-strip" aria-label="Download links">
      {downloadLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </section>

  <section class="status-strip" aria-label="Current implemented package slice">
    <strong>Implemented slice</strong>
    <span><code>dpbase</code> storage</span>
    <span><code>dpmat</code> known data</span>
    <span><code>dpvar</code> decisions</span>
    <span><code>rhodiff</code> rate rows</span>
    <span><code>dplmi</code> YALMIP assembly</span>
    <a href={local("documents/status-and-limits/")}>Full status and limits</a>
  </section>
</div>

<style>
  :global(.sl-container) {
    max-width: 1180px;
  }

  :global(.sl-markdown-content) {
    max-width: none;
  }

  :global(.sl-markdown-content > .home-portal) {
    margin-block: -1rem 2rem;
  }

  .home-portal {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: clamp(2rem, 4vw, 3.4rem);
    color: var(--sl-color-text);
  }

  .home-portal::before {
    content: "";
    position: absolute;
    inset: -5rem -2.5rem -3rem;
    z-index: -1;
    border-radius: 34px;
    background:
      linear-gradient(115deg, color-mix(in srgb, #2563eb 18%, transparent), transparent 44%),
      linear-gradient(245deg, color-mix(in srgb, #14b8a6 18%, transparent), transparent 52%),
      conic-gradient(from 220deg at 72% 14%, rgb(37 99 235 / 0.18), rgb(15 118 110 / 0.16), rgb(124 58 237 / 0.12), rgb(37 99 235 / 0.18)),
      linear-gradient(180deg, color-mix(in srgb, var(--sl-color-bg) 94%, #e0f2fe), color-mix(in srgb, var(--sl-color-bg) 96%, #ecfeff));
    background-size: 150% 150%, 130% 130%, 140% 140%, auto;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.52);
    opacity: 0.92;
  }

  .home-portal::after {
    content: "";
    position: absolute;
    inset: -5rem -2.5rem -3rem;
    z-index: -1;
    border-radius: 34px;
    background:
      linear-gradient(90deg, rgb(37 99 235 / 0.055) 1px, transparent 1px),
      linear-gradient(180deg, rgb(15 118 110 / 0.045) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(180deg, black, rgb(0 0 0 / 0.68), transparent);
  }

  @supports (animation-timeline: scroll()) {
    .home-portal::before {
      animation: portal-gradient-shift linear both;
      animation-timeline: scroll(root block);
    }

    @keyframes portal-gradient-shift {
      from {
        background-position: 0% 0%, 100% 0%, 50% 0%, 0 0;
      }

      to {
        background-position: 26% 18%, 72% 28%, 38% 46%, 0 0;
      }
    }
  }

  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(22rem, 0.82fr);
    gap: clamp(1.6rem, 4vw, 3rem);
    align-items: stretch;
    min-height: 28rem;
    padding: clamp(1.35rem, 3.4vw, 3rem);
    border: 1px solid rgb(96 165 250 / 0.3);
    border-radius: 28px;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 0.78), rgb(255 255 255 / 0.42)),
      linear-gradient(180deg, color-mix(in srgb, var(--sl-color-bg) 96%, #dbeafe), color-mix(in srgb, var(--sl-color-bg) 90%, #ccfbf1));
    box-shadow:
      0 24px 70px rgb(15 23 42 / 0.14),
      inset 0 1px 0 rgb(255 255 255 / 0.78);
    overflow: hidden;
  }

  .home-copy {
    display: grid;
    align-content: center;
    gap: 1.1rem;
    min-width: 0;
  }

  .home-wordmark {
    margin: 0;
    color: var(--sl-color-text);
    font-size: clamp(4rem, 11vw, 8.4rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.9;
  }

  .home-subtitle {
    max-width: 32ch;
    margin: 0;
    color: var(--sl-color-text);
    font-size: clamp(1.25rem, 2.6vw, 2rem);
    font-weight: 750;
    line-height: 1.16;
  }

  .home-label {
    margin: 0;
    color: var(--sl-color-text-accent);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .section-heading h2,
  .download-panel h2 {
    margin: 0;
    color: var(--sl-color-text);
    letter-spacing: 0;
  }

  .home-summary,
  .section-heading p:not(.home-label),
  .download-panel p {
    max-width: 66ch;
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 1.04rem;
    line-height: 1.65;
  }

  .home-actions,
  .download-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    align-items: center;
  }

  .home-actions a,
  .download-strip a {
    border: 1px solid rgb(148 163 184 / 0.34);
    border-radius: 999px;
    padding: 0.78rem 1rem;
    color: var(--sl-color-text);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    background: rgb(255 255 255 / 0.68);
    box-shadow:
      0 12px 30px rgb(15 23 42 / 0.08),
      inset 0 1px 0 rgb(255 255 255 / 0.72);
    backdrop-filter: blur(12px);
  }

  .home-actions a:first-child {
    color: white;
    border-color: transparent;
    background: linear-gradient(135deg, #2563eb, #0f766e);
    box-shadow: 0 18px 36px rgb(37 99 235 / 0.22);
  }

  .lpv-visual {
    display: grid;
    align-items: center;
    min-width: 0;
    border-radius: 26px;
    background:
      linear-gradient(145deg, rgb(255 255 255 / 0.72), rgb(219 234 254 / 0.44)),
      linear-gradient(180deg, rgb(255 255 255 / 0.54), rgb(240 253 250 / 0.28));
    box-shadow:
      0 20px 50px rgb(15 23 42 / 0.12),
      inset 0 1px 0 rgb(255 255 255 / 0.84);
    transform: perspective(1000px) rotateY(-3deg) rotateX(1deg);
  }

  .lpv-visual svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .lpv-shell {
    fill: url("#lpv-card");
    stroke: rgb(37 99 235 / 0.18);
    stroke-width: 1.2;
  }

  .lpv-curve {
    fill: none;
    stroke: url("#lpv-accent");
    stroke-width: 4.5;
    stroke-linecap: round;
  }

  .lpv-dot {
    fill: #2563eb;
    stroke: white;
    stroke-width: 3;
  }

  .lpv-annotation,
  .lpv-block text {
    fill: #0f172a;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-size: 18px;
    font-weight: 760;
  }

  .lpv-annotation {
    fill: #334155;
    font-size: 15px;
    font-weight: 800;
  }

  .lpv-block rect {
    fill: rgb(255 255 255 / 0.8);
    stroke: rgb(30 64 175 / 0.18);
    stroke-width: 1.2;
    filter: drop-shadow(0 12px 18px rgb(15 23 42 / 0.1));
  }

  .lpv-block text + text {
    fill: #334155;
    font-size: 13px;
    font-weight: 650;
  }

  .lpv-detail {
    font-size: 13px;
  }

  .lpv-block.emphasis rect {
    fill: rgb(239 246 255 / 0.9);
    stroke: rgb(37 99 235 / 0.36);
  }

  .lpv-block.solver rect {
    fill: rgb(15 118 110 / 0.1);
    stroke: rgb(15 118 110 / 0.28);
  }

  .lpv-link {
    fill: none;
    stroke: #2563eb;
    stroke-width: 3;
    stroke-linecap: round;
    marker-end: url("#lpv-arrow");
  }

  .lpv-link.muted {
    stroke: #0f766e;
    stroke-width: 2.5;
  }

  .lpv-arrow-head {
    fill: currentColor;
    color: #2563eb;
  }

  .product-walkthrough {
    display: grid;
    gap: 1.35rem;
    padding: clamp(1rem, 2.4vw, 1.6rem);
    border: 1px solid rgb(148 163 184 / 0.28);
    border-radius: 24px;
    background: rgb(255 255 255 / 0.62);
    box-shadow: 0 18px 52px rgb(15 23 42 / 0.09);
    backdrop-filter: blur(14px);
  }

  .section-heading {
    display: grid;
    gap: 0.45rem;
  }

  .section-heading h2,
  .download-panel h2 {
    font-size: clamp(1.55rem, 3vw, 2.3rem);
    line-height: 1.08;
  }

  .lmi-narrative {
    display: grid;
    gap: 0;
  }

  .lmi-step {
    display: grid;
    grid-template-columns: minmax(3.5rem, 0.12fr) minmax(0, 1fr);
    gap: clamp(1rem, 2.2vw, 2rem);
    padding-block: clamp(1.35rem, 2.8vw, 2.35rem);
    border-block-start: 1px solid rgb(148 163 184 / 0.28);
  }

  .lmi-step:last-child {
    border-block-end: 1px solid rgb(148 163 184 / 0.28);
  }

  .step-number {
    color: color-mix(in srgb, var(--sl-color-text-accent) 74%, #0f766e);
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.95;
  }

  .step-copy {
    display: grid;
    gap: 0.65rem;
    min-width: 0;
  }

  .step-copy h3 {
    margin: 0;
    color: var(--sl-color-text);
    font-size: clamp(1.15rem, 2.2vw, 1.55rem);
    letter-spacing: 0;
    line-height: 1.18;
  }

  .step-copy p {
    max-width: 76ch;
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 1rem;
    line-height: 1.72;
  }

  .math-strip {
    max-width: 100%;
    margin-block-start: 0.35rem;
    padding-inline-start: clamp(0.8rem, 1.6vw, 1.15rem);
    border-inline-start: 3px solid color-mix(in srgb, var(--sl-color-text-accent) 72%, #0f766e);
    color: var(--sl-color-text);
    overflow-x: auto;
  }

  .math-strip :global(mjx-container) {
    margin: 0;
    padding-block: 0.2rem;
  }

  .math-strip :global(svg) {
    max-width: none;
  }

  .formula-panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2rem);
    padding-block-start: 0.3rem;
  }

  .formula-panel > div {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
    padding-block: 0.35rem;
    padding-inline-start: 0.9rem;
    border-inline-start: 2px solid rgb(37 99 235 / 0.45);
  }

  .formula-panel strong {
    color: var(--sl-color-text-accent);
  }

  .formula-panel p {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    color: var(--sl-color-gray-2);
  }

  .formula-panel code {
    width: fit-content;
    max-width: 100%;
    overflow-x: auto;
  }

  .home-grid {
    display: grid;
    gap: 1rem;
  }

  .manual-entry-list {
    display: grid;
    gap: 0.7rem;
  }

  .manual-entry-list a {
    display: grid;
    grid-template-columns: minmax(10rem, 0.36fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    border: 1px solid rgb(148 163 184 / 0.22);
    border-radius: 18px;
    padding: 0.95rem 1rem;
    text-decoration: none;
    background: rgb(255 255 255 / 0.54);
    box-shadow: 0 10px 24px rgb(15 23 42 / 0.05);
  }

  .manual-entry-list strong {
    color: var(--sl-color-text-accent);
  }

  .manual-entry-list span {
    color: var(--sl-color-gray-2);
  }

  .download-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.45fr);
    gap: 1rem;
    align-items: center;
    padding: clamp(1rem, 2vw, 1.4rem);
    border: 1px solid rgb(148 163 184 / 0.24);
    border-radius: 24px;
    background: rgb(255 255 255 / 0.6);
    box-shadow: 0 16px 42px rgb(15 23 42 / 0.08);
  }

  .status-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    align-items: center;
    color: var(--sl-color-gray-2);
  }

  .status-strip strong,
  .status-strip span,
  .status-strip a {
