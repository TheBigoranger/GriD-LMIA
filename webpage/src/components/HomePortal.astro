---
import ConvolutionDiagram from "./ConvolutionDiagram.astro";
import PdmatStorageDiagram from "./PdmatStorageDiagram.astro";
import WorkflowStepDiagram from "./WorkflowStepDiagram.astro";
import { renderDisplayMath } from "../lib/mathjax.js";
import { versionInfo } from "../data/version.js";

const base = import.meta.env.BASE_URL;
const local = (path) => `${base.replace(/\/?$/, "/")}${path.replace(/^\/+/, "")}`;

const primaryLinks = [
  { href: local("documents/"), label: "Open manual" },
  { href: local("documents/reference-index/"), label: "Function lookup" },
  { href: local("install/"), label: "Install" },
  { href: local("examples/solver-smoke/"), label: "Solver examples" },
];

const manualLinks = [
  { href: local("documents/reference-index/"), title: "Lookup by name", text: "Find every implemented class, constructor, method, operator family, and solver-facing task." },
  { href: local("documents/math/bernstein-polynomial/"), title: "Bernstein mathematics", text: "Build the idea from local coordinates through weighted convolution, derivatives, and certificates." },
  { href: local("documents/reference/pdmat/matrix-operations/"), title: "Known-data products", text: "See exact degree alignment, ordered products, tensor generalization, and validation boundaries." },
  { href: local("documents/reference/pdvar/matrix-operations/"), title: "Decision products", text: "Distinguish supported known-data products from rejected nonlinear decision products." },
  { href: local("documents/reference/pdlmi/"), title: "Choose a certificate", text: "Compare direct, Pólya, Putinar, and full-box assembly before the YALMIP handoff." },
];

const lmiSteps = [
  {
    number: "01",
    title: "State a PD-LMI or DPD-LMI",
    text: "PD-LMI means parameter-dependent LMI. When bounded scheduling rates and derivatives of decision functions are present, the more specific name is differentiable PD-LMI (DPD-LMI). Removing the derivative term returns an ordinary PD-LMI.",
    math: "\\dot P(\\rho,\\dot\\rho)+P(\\rho)A(\\rho)+A(\\rho)^{\\mathsf T}P(\\rho)\\preceq-\\varepsilon I,\\qquad P(\\rho)\\succeq I.",
  },
  {
    number: "02",
    title: "Choose the physical grid and polynomial degrees",
    text: "Use two physical cells on [0,1]. The known matrix A is affine, while the continuous symmetric decision P is quadratic. Each cell has three local P coefficients; one interface value is shared, so there are five global matrix controls.",
    math: "\\text{grid}=\\{[0,0.5,1]\\},\\qquad \\deg A=1,\\qquad \\deg P=2.",
    kind: "store",
    code: "yalmip('clear')\ngrid = {[0 0.5 1]};\nA = pdmat(grid, @(rho) [-1 .5; -1 -2] + ...\n    rho*[-1.3 -20; 2 -10], Degree=1);\nP = pdvar(2, grid, \"symmetric\", Degree=2);\nfprintf(\"cells=%d, local=%d, global=%d\\n\", ...\n    P.ncell(), P.ncoeff(), 2*P.Degree+1);",
    output: "cells=2, local=3, global=5",
  },
  {
    number: "03",
    title: "Multiply and differentiate cell locally",
    text: "Bernstein products are weighted coefficient convolutions with matrix order preserved. Quadratic P times affine A is cubic. rhodiff(P) uses forward differences inside each physical cell, lowers degree to one, and creates rows for the two rate vertices −1 and +1.",
    math: "\\deg(PA)=3,\\qquad \\deg(\\operatorname{rhodiff}P)=1,\\qquad \\dot\\rho\\in\\{-1,+1\\}.",
    kind: "assemble",
    code: "PA = P*A;\nD = rhodiff(P, [-1 1]);\nresidual = D + PA + A'*P;\nfprintf(\"PA=%d, D=%d, residual=%d, rows=%d\\n\", ...\n    PA.Degree, D.Degree, residual.Degree, ...\n    size(D.coeffs(1),1));",
    output: "PA=3, D=1, residual=3, rows=2",
  },
  {
    number: "04",
    title: "Count the direct finite certificate",
    text: "Addition exactly elevates the degree-one derivative rows to the cubic residual degree. Direct decay certification visits two cells, two rate rows, and four cubic labels. Positivity visits two cells and three quadratic labels.",
    math: "2\\times2\\times4=16\\quad\\text{decay constraints},\\qquad 2\\times3=6\\quad\\text{positivity constraints}.",
    kind: "solve",
    code: "Cdecay = residual <= -1e-6*eye(2);\nCpositive = P >= eye(2);\nfprintf(\"decay=%d, positivity=%d\\n\", ...\n    numel(Cdecay.Constraints), ...\n    numel(Cpositive.Constraints));",
    output: "decay=16, positivity=6",
  },
];
---

<div class="home-portal">
  <section class="home-hero" aria-label="PD-LMI welcome portal">
    <div class="home-copy">
      <p class="home-kicker">MATLAB / YALMIP</p>
      <p class="home-wordmark">PD-LMI</p>
      <p class="home-subtitle">Parameter-dependent LMIs, represented cell by cell.</p>
      <p class="home-summary">
        Model continuous piecewise-polynomial matrix functions on physical grid
        cells using a cell-local tensor-product Bernstein basis. Use DPD-LMI
        only when the model explicitly includes differentiable decisions and
        bounded parameter rates.
      </p>
      <nav class="home-actions" aria-label="Primary documentation links">
        {primaryLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>
    <div class="hero-flow" role="img" aria-label="A continuous PD-LMI is represented by cell-local Bernstein data, certified by finite constraints, and exported through YALMIP to an SDP solver.">
      <section><b>PD-LMI / DPD-LMI</b><span>continuous domain</span></section>
      <b aria-hidden="true">↓</b>
      <section><b>Bernstein data</b><span>physical cells + local labels</span></section>
      <b aria-hidden="true">↓</b>
      <section><b>Finite certificate</b><span>direct / Pólya / Putinar / full box</span></section>
      <b aria-hidden="true">↓</b>
      <section class="hero-flow__result"><b>YALMIP / SDP</b><span>ordinary solver interface</span></section>
    </div>
  </section>

  <section class="product-walkthrough" aria-labelledby="walkthrough-title">
    <header class="section-heading">
      <p class="home-label">Worked spine · {versionInfo.current}</p>
      <h2 id="walkthrough-title">From one quadratic two-cell DPD-LMI to finite constraints</h2>
      <p>Each step pairs the mathematical conclusion with the exact public API call and a deterministic transcript.</p>
    </header>

    <div class="lmi-narrative">
      {lmiSteps.map((step) => (
        <section class:list={["lmi-step", { illustrated: step.kind }]}>
          <div class="step-number" aria-hidden="true">{step.number}</div>
          <div class="step-content">
            <div class="step-copy">
              <h3>{step.title}</h3>
              <p>{step.text}</p>
              <div class="math-strip" set:html={renderDisplayMath(step.math)} />
              {step.code && <div class="step-example"><pre><code>{step.code}</code></pre><pre class="step-output"><code>{step.output}</code></pre></div>}
            </div>
            {step.kind && <WorkflowStepDiagram kind={step.kind} />}
          </div>
        </section>
      ))}
    </div>

    <PdmatStorageDiagram />
    <ConvolutionDiagram />
  </section>

  <section class="manual-section" aria-labelledby="manual-title">
    <header class="section-heading"><p class="home-label">Manual entrances</p><h2 id="manual-title">Continue from the idea you need.</h2></header>
    <div class="manual-entry-list">
      {manualLinks.map((link) => <a href={link.href}><strong>{link.title}</strong><span>{link.text}</span></a>)}
    </div>
  </section>

  <section class="download-panel">
    <div><p class="home-label">Source and manual</p><h2>Use the synchronized {versionInfo.current} documentation.</h2><p>The printable manual and online reference use the same terminology, worked example, and API boundary.</p></div>
    <nav class="download-links" aria-label="Download links">
      <a href="https://github.com/TheBigoranger/PD-LMI-package">Current source</a>
      <a href={local("manual.pdf")}>Printable manual</a>
      <a href={local("version-history/")}>Version history</a>
    </nav>
  </section>
</div>

<style>
  :global(.sl-container) { max-width: 1180px; }
  :global(.sl-markdown-content) { max-width: none; }
  :global(.sl-markdown-content > .home-portal) { margin-block: -1rem 2rem; }

  .home-portal { display: grid; gap: clamp(2rem, 4vw, 3.2rem); }
  .home-hero,
  .product-walkthrough,
  .download-panel { border: 1px solid var(--diagram-border); border-radius: 22px; background: var(--diagram-surface); box-shadow: 0 20px 50px rgb(15 23 42 / 0.08); }
  .home-hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(17rem, 0.7fr); gap: clamp(1.4rem, 4vw, 2.8rem); padding: clamp(1.3rem, 3.5vw, 2.8rem); }
  .home-copy { display: grid; align-content: center; gap: 0.9rem; min-width: 0; }
  .home-kicker,
  .home-label { margin: 0; color: var(--sl-color-text-accent); font-size: 0.78rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .home-wordmark { margin: 0; font-size: clamp(3.7rem, 10vw, 7.4rem); font-weight: 900; line-height: 0.88; }
  .home-subtitle { margin: 0; font-size: clamp(1.25rem, 2.5vw, 1.9rem); font-weight: 750; line-height: 1.2; }
  .home-summary,
  .section-heading > p:not(.home-label),
  .download-panel p { max-width: 68ch; margin: 0; color: var(--sl-color-gray-2); line-height: 1.65; }
  .home-actions,
  .download-links { display: flex; flex-wrap: wrap; gap: 0.65rem; }
  .home-actions a,
  .download-links a { border: 1px solid var(--diagram-border); border-radius: 999px; padding: 0.68rem 0.9rem; color: var(--sl-color-text); text-decoration: none; background: var(--sl-color-bg); font-weight: 700; }
  .home-actions a:first-child { color: white; border-color: transparent; background: linear-gradient(135deg, var(--diagram-input), var(--diagram-result)); }

  .hero-flow { display: grid; gap: 0.42rem; align-content: center; }
  .hero-flow > section { display: grid; gap: 0.2rem; place-items: center; border: 1px solid var(--diagram-input); border-radius: 11px; padding: 0.7rem; text-align: center; background: var(--sl-color-bg); }
  .hero-flow > section span { color: var(--sl-color-gray-2); font-size: 0.73rem; }
  .hero-flow > b { color: var(--sl-color-text-accent); text-align: center; }
  .hero-flow .hero-flow__result { border-color: var(--diagram-result); }

  .product-walkthrough { display: grid; gap: 1.2rem; padding: clamp(1rem, 2.5vw, 1.6rem); }
  .section-heading { display: grid; gap: 0.45rem; }
  .section-heading h2,
  .download-panel h2 { margin: 0; font-size: clamp(1.5rem, 3vw, 2.2rem); line-height: 1.12; }
  .lmi-step { display: grid; grid-template-columns: 3.2rem minmax(0, 1fr); gap: 1rem; padding-block: 1.35rem; border-block-start: 1px solid var(--diagram-border); }
  .step-number { color: var(--sl-color-text-accent); font-size: 2rem; font-weight: 900; }
  .step-content,
  .step-copy { display: grid; gap: 0.75rem; min-width: 0; }
  .lmi-step.illustrated .step-content { grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.85fr); align-items: center; }
  .step-copy h3,
  .step-copy p { margin: 0; }
  .step-copy p { color: var(--sl-color-gray-2); line-height: 1.65; }
  .math-strip { max-width: 100%; border-inline-start: 3px solid var(--sl-color-accent); padding-inline-start: 0.8rem; }
  .math-strip :global(mjx-container) { margin: 0; }
  .math-strip :global(svg) { max-width: 100%; height: auto; }
  .step-example { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(8rem, 0.6fr); gap: 0.45rem; min-width: 0; }
  .step-example pre { min-width: 0; margin: 0; border: 1px solid var(--diagram-border); border-radius: 9px; padding: 0.65rem; overflow-x: auto; background: var(--sl-color-bg); }
  .step-output { border-color: var(--diagram-result) !important; }

  .manual-section { display: grid; gap: 1rem; }
  .manual-entry-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
  .manual-entry-list a { display: grid; gap: 0.35rem; border: 1px solid var(--diagram-border); border-radius: 12px; padding: 0.9rem; text-decoration: none; background: var(--sl-color-bg); }
  .manual-entry-list strong { color: var(--sl-color-text-accent); }
  .manual-entry-list span { color: var(--sl-color-gray-2); }
  .download-panel { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; align-items: center; padding: 1.2rem; }
  .download-panel > div { display: grid; gap: 0.45rem; }
  .download-links { justify-content: flex-end; }

  @media (max-width: 820px) {
    .home-hero,
    .lmi-step.illustrated .step-content,
    .download-panel { grid-template-columns: 1fr; }
    .download-links { justify-content: flex-start; }
  }

  @media (max-width: 600px) {
    .lmi-step,
    .step-example,
    .manual-entry-list { grid-template-columns: 1fr; }
    .step-number { font-size: 1.45rem; }
  }

  @media (max-width: 390px) {
    .home-hero,
    .product-walkthrough { border-radius: 16px; padding: 0.85rem; }
    .home-actions a,
    .download-links a { width: 100%; text-align: center; }
  }
</style>
