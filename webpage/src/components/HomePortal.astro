---
import CellStorageExplorer from "./CellStorageExplorer.tsx";
import CertificateFlow from "./CertificateFlow.astro";
import ExportSolveFlow from "./ExportSolveFlow.astro";
import JourneyCurve from "./JourneyCurve.astro";
import { renderDisplayMath, renderInlineMath } from "../lib/katex.js";
import { versionInfo } from "../data/version.js";

const base = import.meta.env.BASE_URL;
const local = (path) => `${base.replace(/\/?$/, "/")}${path.replace(/^\/+/, "")}`;

const primaryLinks = [
  { href: local("documents/"), label: "Open manual" },
  { href: local("documents/reference-index/"), label: "Function lookup" },
  { href: local("install/"), label: "Install" },
  { href: local("examples/solver-smoke/"), label: "Solver examples" },
];

const lmiSteps = [
  {
    number: "01",
    title: "Model an LPV induced-L2-gain problem",
    text: "x(t) is the plant state, w(t) is the disturbance, and z(t) is the performance output. Seek a parameter-dependent Lyapunov matrix P and an induced-L2 bound gamma.",
    math: [
      "\\dot x=A(\\boldsymbol\\rho)x+B(\\boldsymbol\\rho)w,\\qquad z=C(\\boldsymbol\\rho)x+D(\\boldsymbol\\rho)w.",
      "\\boldsymbol\\rho\\in\\mathcal P,\\quad\\boldsymbol\\nu=\\dot{\\boldsymbol\\rho}\\in\\mathcal R,\\quad\\lVert z\\rVert_2<\\gamma\\lVert w\\rVert_2.",
    ],
    manual: "documents/math/modeling-and-analysis/dpd-lmi-and-lpv-l2-gain/",
  },
  {
    number: "02",
    title: "Reduce the rate box and grid ",
    titleMath: "\\boldsymbol\\rho",
    text: "Affine dependence on the scheduling rate makes rate-box vertex reduction exact. The remaining parameter box is partitioned by an anisotropic tensor grid.",
    math: [
      "\\mathcal G_s=\\{\\rho_s^{(1)},\\ldots,\\rho_s^{(k_s)}\\},\\qquad\\mathcal H_{\\mathbf c}=\\prod_{s=1}^{\\ell}[\\rho_s^{(c_s)},\\rho_s^{(c_s+1)}].",
      "\\footnotesize A(\\rho_1,\\rho_2)=\\begin{bmatrix}1+\\rho_1+\\rho_2&\\rho_1\\rho_2\\\\\\rho_1\\rho_2&2+\\rho_1^2\\end{bmatrix}.",
    ],
    visual: "storage",
    manual: "documents/math/modeling-and-analysis/rate-box-and-interface-analysis/",
    visibleCode: "grid = {[0 0.5 1], [0 1]};\nA = pdmat(grid, @(r1,r2) [1+r1+r2 r1*r2; r1*r2 2+r1^2], Degree=2);",
    fullCode: "grid = {[0 0.5 1], [0 1]};\nA = pdmat(grid, @(r1,r2) [1+r1+r2 r1*r2; r1*r2 2+r1^2], Degree=2);\nA.cells()\nA.LocalValues{c1}{1}",
  },
  {
    number: "03",
    title: "Pull back, differentiate, and assemble coefficients",
    textHtml: `Map every physical cell forward to ${renderInlineMath("\\boldsymbol\\alpha\\in[0,1]^\\ell")}. Value continuity shares complete face controls, while cellwise derivatives retain the reciprocal width ${renderInlineMath("1/h_s^{(\\mathbf c)}")}. Stored rate rows are then stacked into a local Bernstein residual.`,
    math: [
      "\\boldsymbol\\alpha=\\phi_{\\mathbf c}(\\boldsymbol\\rho),\\qquad\\alpha_s=\\frac{\\rho_s-\\rho_s^{(c_s)}}{h_s^{(\\mathbf c)}}.",
      "S^{(\\mathbf c)}(\\boldsymbol\\alpha)=\\sum_{\\mathbf i}C^{(\\mathbf c)}[\\mathbf i]B_{\\mathbf i}^{\\mathbf M}(\\boldsymbol\\alpha)\\succeq0.",
    ],
    visibleCode: "P = pdvar(n, grid, \"symmetric\", Degree=2); D = rhodiff(P, rateBounds);\nL = D + P*A + A'*P <= -epsilon*eye(n);",
    fullCode: "yalmip('clear')\nP = pdvar(n, grid, \"symmetric\", Degree=2);\nD = rhodiff(P, rateBounds);\nL = D + P*A + A'*P <= -epsilon*eye(n);",
    manual: "documents/math/coordinates-and-bernstein/coefficient-algebra/",
  },
  {
    number: "04",
    title: "Select a finite certificate",
    text: "Choose one finite sufficient representation for the same sign-normalized target. Direct is the default; Pólya, Putinar, SparseFullBox, and FullBox are explicit alternatives. This certificate step is not the exact rate-box reduction.",
    math: "S^{(\\mathbf c)}(\\boldsymbol\\alpha)=\\sum_{\\mathbf i\\in\\mathcal I_M}C^{(\\mathbf c)}[\\mathbf i]B_{\\mathbf i}^{M}(\\boldsymbol\\alpha)\\succeq0.",
    visual: "certificate",
    visibleCode: "selected = L.applyPolya(d);\n% or L, Putinar, SparseFullBox, FullBox",
    fullCode: "selected = L;                                  % Direct\nselected = L.applyPolya(d);                    % Pólya increment d\nselected = L.applyPutinar(r);                  % absolute Gram order r\nselected = L.applySparseFullBoxPreorder(b, r); % bandwidth b\nselected = L.applyFullBoxPreorder(r);          % full-box preordering",
    manual: "documents/math/sos-certificates/",
  },
  {
    number: "05",
    title: "Export, solve, and recover the decision matrix",
    text: "Export the finite constraints to YALMIP, call the selected solver, validate diagnostics.problem == 0, and only then evaluate P and retain gamma. A failed certificate or nonzero solver status is inconclusive for the continuous problem.",
    math: "\\texttt{toYalmip}\\;\\longrightarrow\\;\\texttt{optimize}\\;\\longrightarrow\\;\\texttt{value(P)}",
    visual: "export",
    visibleCode: "optimize(selected.toYalmip(), objective, options);\nPsol = value(P);",
    fullCode: "constraints = selected.toYalmip();\ndiagnostics = optimize(constraints, objective, options);\nassert(diagnostics.problem == 0)\nPsol = value(P);",
    manual: "documents/reference/pdlmi/toyalmip/",
  },
];

---

<div class="home-portal">
  <section class="home-hero" aria-label="PD-LMI welcome portal">
    <div class="home-copy">
      <p class="home-kicker">MATLAB / YALMIP</p>
      <p class="home-wordmark">PD-LMI</p>
      <p class="home-subtitle">From an LPV gain model to finite cellwise certificates.</p>
      <p class="home-summary">
        Analyze an LPV induced-L2-gain problem with continuous
        piecewise-polynomial decisions, exact scheduling-rate vertices,
        cell-local Bernstein algebra, and five selectable finite certificate
        states.
      </p>
      <nav class="home-actions" aria-label="Primary documentation links">
        {primaryLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>
    <JourneyCurve />
  </section>

  <section class="product-walkthrough" aria-labelledby="walkthrough-title">
    <header class="section-heading">
      <p class="home-label">Worked spine · {versionInfo.current}</p>
      <h2 id="walkthrough-title">From the LPV model to YALMIP and a recovered Lyapunov matrix</h2>
      <p>Follow one notation-stable spine. Each stage links to a focused mathematical guide and the relevant API reference.</p>
    </header>

    <div class="lmi-narrative">
      {lmiSteps.map((step) => (
        <section class="lmi-step">
          <div class="step-number" aria-hidden="true">{step.number}</div>
          <div class="step-content">
            <div class="step-copy">
              <h3>{step.title}{step.titleMath && <span class="step-title-math" set:html={renderInlineMath(step.titleMath)} />}{step.titleSuffix}</h3>
              {step.textHtml ? <p set:html={step.textHtml} /> : <p>{step.text}</p>}
              {step.visual === "storage"
                ? <div class="cell-storage-compact"><CellStorageExplorer client:load formulaHtml={step.math.map(renderDisplayMath)} axisHtml={{ x: ["\\rho_2^{(1)}", "\\rho_2^{(2)}"].map(renderInlineMath), y: ["\\rho_1^{(1)}", "\\rho_1^{(2)}", "\\rho_1^{(3)}"].map(renderInlineMath) }} /></div>
                : step.visual === "export"
                  ? <ExportSolveFlow />
                : <div class:list={["math-strip", { "math-strip--stacked": Array.isArray(step.math) }]}>
                    {(Array.isArray(step.math) ? step.math : [step.math]).map((line) => (
                      <div class="math-strip__row" set:html={renderDisplayMath(line)} />
                    ))}
                  </div>}
              {step.visual === "certificate" && <CertificateFlow />}
              {step.fullCode && <div class="example-disclosure"><pre class="example-disclosure__essential"><code>{step.fullCode}</code></pre></div>}
              {step.manual && <a class="manual-step-link" href={local(step.manual)}>Open the detailed manual section ↗</a>}
            </div>
          </div>
        </section>
      ))}
    </div>

  </section>

  <section class="download-panel">
    <div><p class="home-label">Source and manual</p><h2>Use the synchronized {versionInfo.current} documentation.</h2><p>The printable manual and online reference use the same terminology, worked example, and API boundary.</p></div>
    <nav class="download-links" aria-label="Download links">
      <a href="https://github.com/TheBigoranger/PD-LMI-package">Current source</a>
      <a href={local("manual.pdf")}>Printable manual</a>
      <a href={local("version-history/")}>Version history</a>
    </nav>
  </section>
</div>

<style>
  :global(.sl-container) { max-width: 1180px; }
  :global(.sl-markdown-content) { max-width: none; }
  :global(.sl-markdown-content > .home-portal) { margin-block: -1rem 2rem; }

  .home-portal { display: grid; gap: clamp(2rem, 4vw, 3.2rem); }
  .home-hero,
  .download-panel { border: 1px solid var(--diagram-border); border-radius: 22px; background: var(--diagram-surface); box-shadow: 0 20px 50px rgb(15 23 42 / 0.08); }
  .home-hero { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(1.6rem, 3vw, 2.4rem); padding: clamp(1.3rem, 3.5vw, 2.8rem); }
  .home-hero :global(.journey-pipeline) { inline-size: min(100%, 62rem); margin-inline: auto; }
  .home-copy { display: grid; align-content: center; gap: 0.9rem; min-width: 0; max-width: 72ch; }
  .home-kicker,
  .home-label { margin: 0; color: var(--sl-color-text-accent); font-size: 0.78rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .home-wordmark { margin: 0; font-size: clamp(3.7rem, 10vw, 7.4rem); font-weight: 900; line-height: 0.88; }
  .home-subtitle { margin: 0; font-size: clamp(1.25rem, 2.5vw, 1.9rem); font-weight: 750; line-height: 1.2; }
  .home-summary,
  .section-heading > p:not(.home-label),
  .download-panel p { max-width: 68ch; margin: 0; color: var(--sl-color-gray-2); line-height: 1.65; }
  .home-actions,
  .download-links { display: flex; flex-wrap: wrap; gap: 0.65rem; }
  .home-actions a,
  .download-links a { border: 1px solid var(--diagram-border); border-radius: 999px; padding: 0.68rem 0.9rem; color: var(--sl-color-text); text-decoration: none; background: var(--sl-color-bg); font-weight: 700; }
  .home-actions a:first-child { color: white; border-color: transparent; background: linear-gradient(135deg, var(--diagram-input), var(--diagram-result)); }

  .product-walkthrough { display: grid; gap: 1.2rem; }
  .section-heading { display: grid; gap: 0.45rem; }
  .section-heading h2,
  .download-panel h2 { margin: 0; font-size: clamp(1.5rem, 3vw, 2.2rem); line-height: 1.12; }
  .lmi-step { display: grid; grid-template-columns: 3.2rem minmax(0, 1fr); gap: 1rem; padding-block: 1.35rem; border-block-start: 1px solid var(--diagram-border); }
  .step-number { color: var(--sl-color-text-accent); font-size: 2rem; font-weight: 900; }
  .step-content,
  .step-copy { display: grid; gap: 0.75rem; min-width: 0; }
  .step-copy h3,
  .step-copy p { margin: 0; }
  .step-title-math :global(.katex) { font-size: 1em; }
  .cell-storage-compact :global(.cell-explorer) { gap: 0.65rem; }
  .cell-storage-compact :global(.diagram-frame__body) { padding: 0.65rem; }
  .cell-storage-compact :global(.cell-coeffs) { gap: 0.25rem; }
  .cell-storage-compact :global(.cell-coeffs > span) { padding: 0.35rem 0.2rem; }
  .cell-storage-compact :global(.cell-explorer__formula) { display: grid; gap: 0.35rem; padding: 0.75rem 1rem 0.2rem; text-align: center; }
  .cell-storage-compact :global(.cell-explorer__formula .katex-display) { margin: 0; }
  .cell-storage-compact :global(.cell-grid-panel) { display: grid; gap: 0.35rem; min-width: 0; }
  .cell-storage-compact :global(.cell-grid-stage__formula) { justify-self: center; width: 100%; max-width: 100%; padding-block-end: 0.1rem; text-align: center; }
  .cell-storage-compact :global(.cell-grid-stage__formula .katex-display) { margin: 0; }
  .cell-storage-compact :global(.cell-grid-stage) { grid-template-columns: 2rem minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) auto; gap: 0.2rem; }
  .cell-storage-compact :global(.cell-axis-y-wrap) { display: grid; grid-column: 1; grid-row: 1; grid-template-columns: 1fr; align-items: stretch; }
  .cell-storage-compact :global(.cell-axis-ticks) { color: var(--sl-color-gray-2); font-family: "STIX Two Math", Cambria, serif; font-size: 1.15rem; font-weight: 750; }
  .cell-storage-compact :global(.cell-axis-ticks .katex) { font-size: 1.15em; }
  .cell-storage-compact :global(.cell-axis-ticks--y) { display: grid; align-content: space-between; justify-items: end; padding-block: 0.2rem; }
  .cell-storage-compact :global(.cell-axis-ticks--x) { display: flex; grid-column: 2; grid-row: 2; justify-content: space-between; padding-inline: 0.15rem; }
  .cell-storage-compact :global(.cell-grid) { grid-column: 2; grid-row: 1; aspect-ratio: 1 / 1.8; }
  .cell-storage-compact :global(.cell-axis) { font-size: 1.25rem; font-weight: 400; }
  .cell-storage-compact :global(.cell-axis .katex) { font-size: 1.08em; }
  .cell-storage-compact :global(.cell-grid button) { font-size: 0.95rem; font-weight: 520; }
  .cell-storage-compact :global(.cell-grid button.selected) { font-weight: 750; }
  .cell-storage-compact :global(.cell-coeffs > span) { min-height: 3.65rem; gap: 0.08rem; padding: 0.45rem 0.18rem; border-radius: 5px; }
  .cell-storage-compact :global(.cell-coeffs > span > small) { font-size: 0.98rem; line-height: 1.05; }
  .cell-storage-compact :global(.cell-coeffs > span > small .katex) { font-size: 1.08em; }
  .cell-storage-compact :global(.cell-coeff-math) { line-height: 1.05; margin-block-start: -0.12rem; }
  .cell-storage-compact :global(.cell-coeff-math .katex) { font-size: 0.78em; }
  .cell-storage-compact :global(.cell-storage-connector) { z-index: 2; min-width: 0; white-space: nowrap; overflow: visible; font-size: 0.9rem; }
  .cell-storage-compact :global(.cell-storage-connector .katex) { font-size: 1.08em; }
  .cell-storage-compact :global(.cell-readout) { padding-inline-start: 0.45rem; }
  @media (min-width: 701px) {
    .cell-storage-compact :global(.cell-explorer) { inline-size: min(100%, 66rem); margin-inline: auto; gap: 0.85rem; }
    .cell-storage-compact :global(.cell-grid-stage) { inline-size: min(100%, 9.5rem); justify-self: center; }
    .cell-storage-compact :global(.cell-coeffs) { inline-size: 100%; max-inline-size: 100%; justify-self: stretch; }
  }
  .step-copy p { color: var(--sl-color-gray-2); line-height: 1.65; }
  .math-strip { inline-size: min(100%, 54rem); min-width: 0; margin-inline: auto; border-inline-start: 3px solid var(--sl-color-accent); padding-inline-start: 0.8rem; }
  .math-strip :global(.katex-display) { margin: 0; }
  .step-content :global(.diagram-frame) { margin-block: 0.4rem 0; }
  .step-content :global(.certificate-flow) { inline-size: min(100%, 54rem); margin-inline: auto; }
  .step-content :global(.export-solve-flow) { inline-size: min(100%, 58rem); margin-inline: auto; }
  .example-disclosure { min-width: 0; }
  .example-disclosure pre { margin: 0; min-width: 0; overflow-x: auto; }
  .example-disclosure__essential { border-inline-start: 3px solid var(--sl-color-accent); }
  .manual-step-link { width: fit-content; color: var(--sl-color-text-accent); font-size: 0.88rem; font-weight: 750; text-decoration: none; }
  .manual-step-link:hover { text-decoration: underline; }


  .download-panel { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; align-items: center; padding: 1.2rem; }
  .download-panel > div { display: grid; gap: 0.45rem; }
  .download-links { justify-content: flex-end; }

  @media (max-width: 820px) {
    .home-hero,
    .download-panel { grid-template-columns: 1fr; }
    .download-links { justify-content: flex-start; }
  }

  @media (max-width: 600px) {
    .lmi-step { grid-template-columns: 1fr; }
    .step-number { font-size: 1.45rem; }
  }

  @media (max-width: 700px) {
    .cell-storage-compact :global(.cell-grid-stage) { inline-size: min(100%, 14rem); justify-self: center; }
    .cell-storage-compact :global(.cell-coeffs) { inline-size: 100%; max-inline-size: 100%; justify-self: stretch; }
  }

  @media (max-width: 390px) {
    .home-hero,
    .download-panel { border-radius: 16px; padding: 0.85rem; }
    .home-actions a,
    .download-links a { width: 100%; text-align: center; }
  }
</style>
