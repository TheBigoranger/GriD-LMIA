---
import DiagramFrame from "./DiagramFrame.astro";
import { certificateSources } from "../data/certificate-data";

interface Props {
  selected: "direct" | "polya" | "putinar" | "sparseputinar" | "sparsefullbox" | "fullbox";
}

const { selected } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const notes = { direct: "coefficient test", polya: "exact elevation", putinar: "axis generators", sparseputinar: "clique windows", sparsefullbox: "band-limited support", fullbox: "all subsets" } as const;
---

<DiagramFrame
  caption="One residual, six finite certificate choices. The highlighted method is the one used on this page."
  label={`Certificate spectrum with ${selected} selected`}
  class="certificate-spectrum-figure"
>
  <div class="certificate-spectrum" role="list">
    {certificateSources.map((option) => {
      const isSelected = option.key === selected;
      return (
        <a class:list={{ selected: isSelected }} aria-current={isSelected ? "page" : undefined} href={`${base}${option.detailRoute}`} role="listitem">
          <strong>{option.label}</strong>
          <small>{notes[option.key]}</small>
        </a>
      );
    })}
  </div>
</DiagramFrame>

<style>
  .certificate-spectrum { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: 1fr; gap: 0.35rem; }
  a { position: relative; display: grid; gap: 0.25rem; min-width: 0; border: 1px solid var(--diagram-border); border-radius: 8px; padding: 1.1rem 0.65rem; color: var(--sl-color-text); text-align: center; text-decoration: none; }
  strong { min-width: 0; overflow-wrap: anywhere; line-height: 1.15; }
  a:hover, a:focus-visible { color: var(--sl-color-text-accent); background: var(--sl-color-accent-low); }
  a.selected { color: var(--diagram-result); background: color-mix(in srgb, var(--diagram-result) 9%, transparent); box-shadow: inset 0 3px var(--diagram-result); }
  small { color: var(--sl-color-gray-2); font-size: 0.72rem; }
  @media (max-width: 760px) {
    .certificate-spectrum { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 390px) {
    .certificate-spectrum { grid-template-columns: 1fr; }
  }
</style>
