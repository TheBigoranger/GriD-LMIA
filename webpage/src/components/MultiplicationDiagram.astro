---
import DiagramFrame from "./DiagramFrame.astro";
---

<DiagramFrame
  caption="Pointwise multiplication in parameter space is the binomial-weighted convolution of Bernstein coefficients. The two affine inputs become one quadratic result."
  label="Plots and coefficient rows for multiplying two affine functions in the Bernstein basis"
  class="multiplication-diagram"
>
  <div class="multiplication-formulas">
    <strong>Parameter space: R(ρ) = P(ρ)Q(ρ)</strong>
    <span>Coefficient space: rₖ = Σᵢ₊ⱼ₌ₖ [C(1,i)C(1,j)/C(2,k)] pᵢqⱼ</span>
  </div>
  <div class="curve-layout">
    <section class="curve-copy curve-copy--first">
      <h4>P(ρ) = 4 − 2ρ</h4>
      <p>Bernstein [4, 2]</p>
    </section>
    <section class="curve-copy curve-copy--second">
      <h4>Q(ρ) = 0.5 + 2.5ρ</h4>
      <p>Bernstein [0.5, 3]</p>
    </section>
    <section class="curve-copy curve-copy--result">
      <h4>R(ρ) = 2 + 9ρ − 5ρ²</h4>
      <p>Bernstein [2, 6.5, 6]</p>
    </section>
    <svg viewBox="0 0 900 300" role="img" aria-labelledby="multiply-title multiply-desc">
      <title id="multiply-title">Two affine functions and their quadratic product on zero to one</title>
      <desc id="multiply-desc">P descends from four to two while Q rises from one half to three. They cross before their product reaches six.</desc>
      <g class="axes">
        <path d="M60 250 H840"/><path d="M60 250 V35"/>
        <text x="60" y="276" text-anchor="middle">0</text><text x="840" y="276" text-anchor="middle">1</text>
        <text x="450" y="294" text-anchor="middle">ρ</text>
      </g>
      <g class="grid">
        <path d="M60 215 H840 M60 180 H840 M60 145 H840 M60 110 H840 M60 75 H840 M60 40 H840" />
      </g>
      <path class="curve curve--first" d="M60 130 L840 190" />
      <path class="curve curve--second" d="M60 235 L840 160" />
      <path class="curve curve--result" d="M60 190 Q450 55 840 70" />
      <g class="endpoints">
        <circle class="point--first" cx="60" cy="130" r="5"/><circle class="point--first" cx="840" cy="190" r="5"/>
        <circle class="point--second" cx="60" cy="235" r="5"/><circle class="point--second" cx="840" cy="160" r="5"/>
        <circle class="point--result" cx="60" cy="190" r="5"/><circle class="point--result" cx="840" cy="70" r="5"/>
      </g>
    </svg>
  </div>
  <p class="middle-coefficient">The middle result is (4·3 + 2·0.5) / 2 = 6.5.</p>
</DiagramFrame>

<style>
  .multiplication-formulas { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.45rem 1.4rem; padding-block-end: 0.75rem; border-block-end: 1px solid var(--diagram-border); }
  .multiplication-formulas strong { color: var(--sl-color-text); }
  .multiplication-formulas span { color: var(--sl-color-gray-2); font-family: "STIX Two Math", Cambria, serif; }
  .curve-layout { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.7rem 1rem; margin-block-start: 0.9rem; }
  .curve-copy { border-block-start: 3px solid currentColor; padding-block-start: 0.45rem; }
  .curve-copy--first { color: var(--diagram-input); }
  .curve-copy--second { color: var(--diagram-second); }
  .curve-copy--result { color: var(--diagram-result); }
  h4, p { margin: 0; }
  h4 { color: currentColor; font-size: 0.9rem; }
  .curve-copy p { color: var(--sl-color-gray-2); font-size: 0.82rem; }
  svg { grid-column: 1 / -1; overflow: visible; }
  .axes path { fill: none; stroke: var(--sl-color-text); stroke-width: 2; }
  .axes text { fill: var(--sl-color-text); font-family: system-ui, sans-serif; font-size: 16px; }
  .grid path { fill: none; stroke: var(--diagram-border); stroke-width: 1; stroke-dasharray: 4 8; }
  .curve { fill: none; stroke-width: 5; stroke-linecap: round; }
  .curve--first { stroke: var(--diagram-input); }
  .curve--second { stroke: var(--diagram-second); }
  .curve--result { stroke: var(--diagram-result); }
  .point--first { fill: var(--diagram-input); }
  .point--second { fill: var(--diagram-second); }
  .point--result { fill: var(--diagram-result); }
  .middle-coefficient { color: var(--diagram-result); text-align: center; font-weight: 750; }
  @media (max-width: 560px) {
    .curve-layout { grid-template-columns: 1fr; }
    svg { grid-column: auto; }
    .multiplication-formulas { display: grid; }
  }
</style>
