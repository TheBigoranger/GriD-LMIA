<figure class="storage-diagram bernstein-product" aria-label="Bernstein product degree growth diagram">
  <svg viewBox="0 0 760 430" role="img">
    <defs>
      <linearGradient id="linA" x1="0" x2="1">
        <stop offset="0%" stop-color="#2563eb" />
        <stop offset="100%" stop-color="#0f766e" />
      </linearGradient>
      <linearGradient id="quadA" x1="0" x2="1">
        <stop offset="0%" stop-color="#7c3aed" />
        <stop offset="100%" stop-color="#0891b2" />
      </linearGradient>
    </defs>

    <rect x="18" y="18" width="724" height="394" rx="18" fill="#f8fafc" stroke="#cbd5e1" />
    <text x="46" y="56" class="diagram-title">Linear factors multiply into a quadratic Bernstein cell</text>

    <g class="basis-panel">
      <text x="54" y="104" class="panel-title">two degree-1 factors</text>
      <rect x="54" y="126" width="190" height="52" rx="10" fill="url(#linA)" />
      <rect x="54" y="192" width="190" height="52" rx="10" fill="url(#linA)" />
      <text x="74" y="158" class="white">P = B0 P0 + B1 P1</text>
      <text x="74" y="224" class="white">Q = B0 Q0 + B1 Q1</text>
      <text x="70" y="286">B0 = alpha, B1 = 1 - alpha</text>
      <text x="70" y="314" class="small">one local cell in rho</text>
    </g>

    <g class="arrow">
      <path d="M268 185 C300 185 310 185 336 185" />
      <path d="M336 185 l-18 -10 m18 10 l-18 10" />
      <text x="270" y="164">multiply</text>
    </g>

    <g class="quad-panel">
      <text x="352" y="104" class="panel-title">degree-2 Bernstein result</text>
      <rect x="352" y="126" width="334" height="238" rx="14" fill="#eef6ff" stroke="#cbd5e1" />
      <text x="382" y="148" class="small">P Q = B0,2 R0 + B1,2 R1 + B2,2 R2</text>
      <g class="coeff-row">
        <rect x="382" y="166" width="84" height="46" rx="10" fill="url(#quadA)" />
        <rect x="486" y="166" width="118" height="46" rx="10" fill="url(#quadA)" />
        <rect x="624" y="166" width="84" height="46" rx="10" fill="url(#quadA)" />
        <text x="399" y="195" class="white">R0</text>
        <text x="505" y="195" class="white">R1</text>
        <text x="641" y="195" class="white">R2</text>
      </g>
      <text x="382" y="238">R0 = P0 Q0</text>
      <text x="382" y="268">R1 = (P0 Q1 + P1 Q0) / 2</text>
      <text x="382" y="298">R2 = P1 Q1</text>
      <text x="382" y="332" class="small">dpmat and dpvar store these</text>
      <text x="382" y="354" class="small">cell-local coefficients in LocalValues.</text>
    </g>
  </svg>
</figure>
