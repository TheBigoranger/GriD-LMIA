<figure class="storage-diagram" aria-label="dpmat cell-local Bernstein storage diagram">
  <svg viewBox="0 0 720 430" role="img">
    <defs>
      <linearGradient id="cellFill" x1="0" x2="1" y1="0" y2="1">
        <stop offset="0%" stop-color="#e7f5ff" />
        <stop offset="100%" stop-color="#ecfdf5" />
      </linearGradient>
      <linearGradient id="coeffFill" x1="0" x2="1">
        <stop offset="0%" stop-color="#4338ca" />
        <stop offset="100%" stop-color="#0891b2" />
      </linearGradient>
    </defs>
    <rect x="18" y="18" width="684" height="394" rx="18" fill="#f8fafc" stroke="#cbd5e1" />
    <text x="48" y="58" class="diagram-title">
      <tspan x="48" dy="0">dpmat storage</tspan>
      <tspan x="48" dy="28">grid -> cells -> local coefficients</tspan>
    </text>
    <g class="axis">
      <line x1="70" y1="145" x2="650" y2="145" />
      <circle cx="110" cy="145" r="7" />
      <circle cx="300" cy="145" r="7" />
      <circle cx="490" cy="145" r="7" />
      <circle cx="650" cy="145" r="7" />
      <text x="94" y="122">rho_1</text>
      <text x="284" y="122">rho_2</text>
      <text x="474" y="122">rho_3</text>
      <text x="631" y="122">rho_4</text>
    </g>
    <g class="cells">
      <rect x="110" y="176" width="190" height="78" rx="14" fill="url(#cellFill)" />
      <rect x="300" y="176" width="190" height="78" rx="14" fill="url(#cellFill)" />
      <rect x="490" y="176" width="160" height="78" rx="14" fill="url(#cellFill)" />
      <text x="154" y="220">LocalValues{1}</text>
      <text x="344" y="220">LocalValues{2}</text>
      <text x="518" y="220">LocalValues{3}</text>
    </g>
    <g class="coeffs">
      <path d="M205 254 C205 285 158 292 158 322" />
      <path d="M205 254 C205 285 254 292 254 322" />
      <rect x="104" y="322" width="108" height="52" rx="13" fill="url(#coeffFill)" />
      <rect x="218" y="322" width="108" height="52" rx="13" fill="url(#coeffFill)" />
      <text x="130" y="354">B0 * A0</text>
      <text x="244" y="354">B1 * A1</text>
    </g>
    <g class="notes">
      <text x="372" y="318">Degree 1 scalar cells store</text>
      <text x="372" y="344">two local coefficients.</text>
      <text x="372" y="370">Tensor grids expand labels;</text>
      <text x="372" y="396">dpvar reuses this contract.</text>
    </g>
  </svg>
</figure>
