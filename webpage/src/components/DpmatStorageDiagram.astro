---
import { mathjax } from "mathjax-full/js/mathjax.js";
import { liteAdaptor } from "mathjax-full/js/adaptors/liteAdaptor.js";
import { RegisterHTMLHandler } from "mathjax-full/js/handlers/html.js";
import { TeX } from "mathjax-full/js/input/tex.js";
import { SVG } from "mathjax-full/js/output/svg.js";

const adaptor = liteAdaptor();
RegisterHTMLHandler(adaptor);

const tex = new TeX({ packages: ["base"] });
const svg = new SVG({ fontCache: "none" });
const mathDoc = mathjax.document("", { InputJax: tex, OutputJax: svg });

// Render the grid labels at build time so the homepage diagram stays static.
const renderInlineMath = (src) =>
  adaptor.outerHTML(mathDoc.convert(src, { display: false }));

const rhoLabels = [
  { x: "10%", tex: "\\rho_{i-1}" },
  { x: "28%", tex: "\\rho_i" },
  { x: "58%", tex: "\\rho_{i+1}" },
  { x: "78%", tex: "\\rho_{i+2}" },
  { x: "92%", tex: "\\rho_{i+3}" },
];

const formulas = {
  p: "P(\\alpha)=B_{0,1}(\\alpha)P_0+B_{1,1}(\\alpha)P_1",
  q: "Q(\\alpha)=B_{0,1}(\\alpha)Q_0+B_{1,1}(\\alpha)Q_1",
  r: "R(\\alpha)=B_{0,2}(\\alpha)R_0+B_{1,2}(\\alpha)R_1+B_{2,2}(\\alpha)R_2",
};
---

<figure class="storage-diagram bernstein-product" aria-label="Linear Bernstein factors multiply into a quadratic Bernstein product">
  <div class="bernstein-product-card">
    <h3>One local cell: multiply two linear Bernstein factors</h3>
    <div class="factor-equation">
      <div class="factor-stack">
        <section class="factor-panel factor-p" aria-label="P alpha linear factor">
          <div class="formula-line" set:html={renderInlineMath(formulas.p)} />
          <svg viewBox="0 0 360 124" role="img">
            <line x1="22" y1="60" x2="338" y2="60" class="grid-line" />
            <rect x="104" y="32" width="104" height="56" rx="8" class="selected-cell" />
            <path d="M116 17 C104 17 104 32 104 32 C104 44 92 44 92 60 C92 76 104 76 104 88 C104 88 104 103 116 103" class="cell-brace" />
            <path d="M196 17 C208 17 208 32 208 32 C208 44 220 44 220 60 C220 76 208 76 208 88 C208 88 208 103 196 103" class="cell-brace" />
            <path d="M104 78 L208 40" class="line-p" />
            <g class="grid-node">
              <circle cx="54" cy="60" r="9" />
              <circle cx="104" cy="60" r="9" />
              <circle cx="208" cy="60" r="9" />
              <circle cx="282" cy="60" r="9" />
              <circle cx="326" cy="60" r="9" />
            </g>
            <circle cx="104" cy="78" r="6" class="dot-p" />
            <circle cx="208" cy="40" r="6" class="dot-p" />
          </svg>
          <div class="rho-labels" aria-hidden="true">
            {
              rhoLabels.map((label) => (
                <span
                  class="rho-label"
                  style={`--x: ${label.x}`}
                  set:html={renderInlineMath(label.tex)}
                />
              ))
            }
          </div>
          <div class="coeff-strip factor-coeff-strip" aria-label="Stored degree-one P coefficients">
            <code>LocalValues</code>
            <span>P0</span>
            <span>P1</span>
          </div>
        </section>

        <div class="multiply-mark" aria-hidden="true">×</div>

        <section class="factor-panel factor-q" aria-label="Q alpha linear factor">
          <div class="formula-line" set:html={renderInlineMath(formulas.q)} />
          <svg viewBox="0 0 360 124" role="img">
            <line x1="22" y1="60" x2="338" y2="60" class="grid-line" />
            <rect x="104" y="32" width="104" height="56" rx="8" class="selected-cell" />
            <path d="M116 17 C104 17 104 32 104 32 C104 44 92 44 92 60 C92 76 104 76 104 88 C104 88 104 103 116 103" class="cell-brace" />
            <path d="M196 17 C208 17 208 32 208 32 C208 44 220 44 220 60 C220 76 208 76 208 88 C208 88 208 103 196 103" class="cell-brace" />
            <path d="M104 40 L208 82" class="line-q" />
            <g class="grid-node">
              <circle cx="54" cy="60" r="9" />
              <circle cx="104" cy="60" r="9" />
              <circle cx="208" cy="60" r="9" />
              <circle cx="282" cy="60" r="9" />
              <circle cx="326" cy="60" r="9" />
            </g>
            <circle cx="104" cy="40" r="6" class="dot-q" />
            <circle cx="208" cy="82" r="6" class="dot-q" />
          </svg>
          <div class="rho-labels" aria-hidden="true">
            {
              rhoLabels.map((label) => (
                <span
                  class="rho-label"
                  style={`--x: ${label.x}`}
                  set:html={renderInlineMath(label.tex)}
                />
              ))
            }
          </div>
          <div class="coeff-strip factor-coeff-strip" aria-label="Stored degree-one Q coefficients">
            <code>LocalValues</code>
            <span>Q0</span>
            <span>Q1</span>
          </div>
        </section>
      </div>

      <div class="equal-mark" aria-hidden="true">=</div>

      <section class="result-panel" aria-label="R alpha quadratic product">
        <div class="formula-line product-result-formula" set:html={renderInlineMath(formulas.r)} />
        <svg viewBox="0 0 420 188" role="img">
          <line x1="28" y1="108" x2="392" y2="108" class="grid-line" />
          <rect x="126" y="62" width="126" height="84" rx="8" class="selected-cell" />
          <path d="M148 36 C126 36 126 62 126 62 C126 80 108 80 108 104 C108 128 126 128 126 146 C126 146 126 172 148 172" class="cell-brace" />
          <path d="M230 36 C252 36 252 62 252 62 C252 80 270 80 270 104 C270 128 252 128 252 146 C252 146 252 172 230 172" class="cell-brace" />
          <path d="M126 134 C160 45 224 45 252 134" class="curve-r" />
          <g class="grid-node">
            <circle cx="70" cy="108" r="10" />
            <circle cx="126" cy="108" r="10" />
            <circle cx="252" cy="108" r="10" />
            <circle cx="324" cy="108" r="10" />
            <circle cx="378" cy="108" r="10" />
          </g>
          <circle cx="126" cy="134" r="7" class="dot-r" />
          <circle cx="189" cy="52" r="7" class="dot-r" />
          <circle cx="252" cy="134" r="7" class="dot-r" />
        </svg>
        <div class="rho-labels result-rho-labels" aria-hidden="true">
          {
            rhoLabels.map((label) => (
              <span
                class="rho-label"
                style={`--x: ${label.x}`}
                set:html={renderInlineMath(label.tex)}
              />
            ))
          }
        </div>
        <div class="coeff-strip" aria-label="Stored degree-two coefficients">
          <code>LocalValues</code>
          <span>R0</span>
          <span>R1</span>
          <span>R2</span>
        </div>
      </section>
    </div>
  </div>
</figure>

<style>
  .storage-diagram {
    max-width: 760px;
    margin: 0 auto;
  }

  .bernstein-product-card {
    display: grid;
    gap: 0.85rem;
    box-sizing: border-box;
    width: 100%;
    padding: 1rem;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: #f8fafc;
    box-shadow: 0 18px 35px rgb(15 23 42 / 0.14);
  }

  .bernstein-product-card h3 {
    margin: 0;
    color: #0f172a;
    font-size: 1.08rem;
    line-height: 1.25;
  }

  .factor-equation {
    display: grid;
    grid-template-columns: minmax(13rem, 0.82fr) auto minmax(17rem, 1fr);
    gap: 0.45rem;
    align-items: center;
    justify-content: center;
  }

  .factor-stack {
    display: grid;
    gap: 0.55rem;
  }

  .factor-panel,
  .result-panel {
    position: relative;
    min-width: 0;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: white;
  }

  .factor-panel {
    padding: 0.7rem 0.8rem;
  }

  .result-panel {
    padding: 0.7rem 0.8rem 0.85rem;
  }

  .formula-line {
    display: flex;
    min-height: 1.55rem;
    align-items: center;
    justify-content: center;
    margin-block-end: 0.35rem;
    overflow-x: auto;
    text-align: center;
    white-space: nowrap;
  }

  .factor-panel .formula-line {
    font-size: clamp(0.58rem, 1.15vw, 0.72rem);
  }

  .formula-line :global(mjx-container) {
    flex: 0 0 auto;
    margin: 0;
    max-width: none;
  }

  .product-result-formula {
    width: 100%;
    margin-block: 0 0.1rem;
    color: #6d28d9;
    font-size: clamp(0.5rem, 1.05vw, 0.68rem);
  }

  .factor-p .formula-line {
    color: #1d4ed8;
  }

  .factor-q .formula-line {
    color: #c2410c;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .factor-panel .rho-labels,
  .result-panel .rho-labels {
    position: absolute;
    inset-inline: 0.85rem;
    inset-block-start: auto;
    inset-block-end: 3.35rem;
    min-height: 1.2rem;
  }

  .result-panel .rho-labels {
    inset-block-end: 4.35rem;
  }

  .rho-labels span {
    position: absolute;
    inset-inline-start: var(--x);
    transform: translateX(-50%);
    color: #0f172a;
    font-family: "Latin Modern Roman", "STIX Two Math", Cambria, serif;
    font-size: 0.82rem;
    line-height: 1;
    white-space: nowrap;
  }

  .rho-labels :global(mjx-container) {
    display: inline-block;
    margin: 0;
    color: #0f172a;
  }

  .rho-labels :global(mjx-container svg) {
    display: inline-block;
    width: auto;
    height: auto;
  }

  .multiply-mark,
  .equal-mark {
    display: grid;
    min-width: 1.45rem;
    place-items: center;
    color: #0f172a;
    font-family: "Latin Modern Roman", "STIX Two Math", Cambria, serif;
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1;
  }

  .multiply-mark {
    min-height: 2rem;
  }

  .coeff-strip {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    margin-block-start: 0.45rem;
    color: #334155;
    font-size: 0.83rem;
  }

  .factor-coeff-strip {
    margin-block-start: 0.3rem;
  }

  .coeff-strip code {
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 0.18rem 0.34rem;
    color: #0f172a;
    background: #f8fafc;
  }

  .coeff-strip span {
    display: grid;
    min-width: 2.15rem;
    min-height: 1.85rem;
    place-items: center;
    border-radius: 7px;
    color: white;
    font-weight: 800;
    background: #7c3aed;
  }

  .factor-p .coeff-strip span {
    background: #2563eb;
  }

  .factor-q .coeff-strip span {
    background: #f97316;
  }

  .grid-line,
  .cell-brace {
    fill: none;
    stroke: #334155;
    stroke-width: 3;
  }

  .selected-cell {
    fill: #f8fafc;
    stroke: #94a3b8;
    stroke-width: 1.5;
  }

  .grid-node circle {
    fill: #0f172a;
    stroke: #cbd5e1;
    stroke-width: 4;
  }

  .line-p,
  .line-q,
  .curve-r {
    fill: none;
    stroke-linecap: round;
    stroke-width: 6;
  }

  .line-p {
    stroke: #2563eb;
  }

  .line-q {
    stroke: #f97316;
  }

  .curve-r {
    stroke: #7c3aed;
  }

  .dot-p {
    fill: #2563eb;
  }

  .dot-q {
    fill: #f97316;
  }

  .dot-r {
    fill: #7c3aed;
  }

  @media (max-width: 820px) {
    .bernstein-product-card {
      padding: 0.8rem;
    }

    .factor-equation {
      grid-template-columns: 1fr;
    }

    .equal-mark {
      min-height: 2rem;
    }

    .factor-panel,
    .result-panel {
      padding-inline: 0.65rem;
    }
  }
</style>
