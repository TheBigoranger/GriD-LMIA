---
interface Props {
  kind?: "map" | "direct" | "polya" | "fullbox";
}
const { kind = "map" } = Astro.props;
const descriptions = {
  map: "One stored residual branches to direct coefficient testing, Pólya degree elevation followed by coefficient testing, or full-box Gram blocks and coefficient identities.",
  direct: "Nonnegative Bernstein weights combine coefficient matrices, so coefficient-wise positive semidefiniteness certifies the whole cell.",
  polya: "Pólya relaxation elevates the same polynomial to a higher Bernstein degree before applying the direct coefficient test.",
  fullbox: "Full-box relaxation combines positive semidefinite Gram blocks with box-generator products and exact coefficient matching.",
};
---

<figure class="certificate-diagram">
  <div class="certificate-scene" role="img" aria-label={descriptions[kind]}>
    <div class="certificate-track">
      {kind === "map" && (
        <>
        <span class="residual"><b>stored residual</b><small>cells × rate rows</small></span>
        <b class="branch">↗<br />→<br />↘</b>
        <div class="choices"><span><b>Direct</b><small>test every coefficient</small></span><span><b>Pólya</b><small>elevate, then test</small></span><span><b>Full box</b><small>Gram blocks + identities</small></span></div>
        </>
      )}
      {kind === "direct" && (
        <><div class="coeffs"><span>C⁽ᶜ⁾[0] ⪰ 0</span><span>C⁽ᶜ⁾[1] ⪰ 0</span><span>C⁽ᶜ⁾[2] ⪰ 0</span></div><b>＋ nonnegative weights →</b><span class="residual"><b>S(α) ⪰ 0</b><small>for the whole cell</small></span></>
      )}
      {kind === "polya" && (
        <><span class="residual"><b>degree m</b><small>same residual</small></span><b>exact elevation →</b><span class="residual"><b>degree m + r</b><small>more coefficients</small></span><b>→ direct test</b></>
      )}
      {kind === "fullbox" && (
        <><div class="coeffs"><span>Q∅ ⪰ 0</span><span>Q&#123;1&#125; ⪰ 0</span><span>Q&#123;2&#125; ⪰ 0</span><span>Q&#123;1,2&#125; ⪰ 0</span></div><b>× box generators →</b><span class="residual"><b>exact identity</b><small>match every coefficient</small></span></>
      )}
    </div>
  </div>
  <figcaption>{descriptions[kind]}</figcaption>
</figure>

<style>
  .certificate-diagram { margin:1.1rem 0 1.6rem; border:1px solid var(--sl-color-gray-5); border-radius:12px; background:color-mix(in srgb,var(--sl-color-accent-low) 22%,var(--sl-color-bg)); overflow:hidden; }
  .certificate-scene { width:100%; min-width:0; overflow-x:auto; }
  .certificate-track { display:flex; min-width:34rem; min-height:9rem; box-sizing:border-box; align-items:center; justify-content:center; gap:.85rem; padding:1rem; }
  .residual,.choices span,.coeffs span { display:grid; gap:.2rem; place-items:center; border:1px solid var(--sl-color-accent); border-radius:9px; padding:.55rem .7rem; text-align:center; background:var(--sl-color-bg); }
  .choices,.coeffs { display:grid; gap:.4rem; }
  .coeffs { grid-template-columns:repeat(2,minmax(7rem,1fr)); }
  small { color:var(--sl-color-gray-2); font-size:.72rem; }
  .branch { color:var(--sl-color-text-accent); font-size:1.25rem; line-height:1.6; }
  figcaption { border-block-start:1px solid var(--sl-color-gray-5); padding:.7rem .9rem; color:var(--sl-color-gray-2); font-size:.86rem; }
  @media(max-width:520px){.certificate-diagram{margin-inline:-.25rem}}
</style>
