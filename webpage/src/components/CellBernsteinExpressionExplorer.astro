---
import CellBernsteinExpressionExplorer from "./CellBernsteinExpressionExplorer.tsx";
import { pdmatCellData } from "../lib/cell-bernstein.ts";
import { renderMath } from "../lib/katex-renderer.js";

const sliderValues = Array.from({ length: 21 }, (_, index) => index / 20);
const mathMarkup = {
  globalLhs: renderMath(`A(\\boldsymbol\\rho)=`),
  globalMatrix: renderMath(`\\begin{bmatrix}
    1+\\rho_1+\\rho_2 & \\rho_1\\rho_2\\\\
    \\rho_1\\rho_2 & 2+\\rho_1^2
    \\end{bmatrix},`),
  globalDomain: renderMath(`\\boldsymbol\\rho\\in[0,1]^2.`),
  alpha1: sliderValues.map((value) => renderMath(`\\alpha_1=${value.toFixed(2)}`)),
  alpha2: sliderValues.map((value) => renderMath(`\\alpha_2=${value.toFixed(2)}`)),
  termBasis: Array.from({ length: 9 }, (_, index) => {
    const i = Math.floor(index / 3);
    const j = index % 3;
    return renderMath(`B_{(${i},${j})}^{2}(\\boldsymbol\\alpha)`);
  }),
  termWeightPrefix: Array.from({ length: 9 }, (_, index) => {
    const i = Math.floor(index / 3);
    const j = index % 3;
    return renderMath(`B_${i}^2(\\alpha_1)B_${j}^2(\\alpha_2)=`);
  }),
  cells: pdmatCellData.map((cell) => ({
    domain: renderMath(cell.domainTex),
    representationLhs: renderMath(`A^{(${cell.c1},1)}(\\boldsymbol\\alpha)=`),
    representationSum: renderMath(`\\sum_{\\mathbf i\\in\\{0,1,2\\}^{2}}C_{\\mathbf i}^{(${cell.c1},1)}B_{\\mathbf i}^{2}(\\boldsymbol\\alpha),`),
    basisDefinition: renderMath(`B_{\\mathbf i}^{2}(\\boldsymbol\\alpha)=B_{i_1}^{2}(\\alpha_1)B_{i_2}^{2}(\\alpha_2).`),
    coefficientLabels: cell.coefficients.map((_, index) => {
      const i = Math.floor(index / 3);
      const j = index % 3;
      return renderMath(`C_{${i},${j}}^{(${cell.c1},1)}=`);
    }),
    coefficientValues: cell.coefficients.map((coefficient) => renderMath(coefficient.tex)),
    valuePrefix: renderMath(`A^{(${cell.c1},1)}(\\boldsymbol\\alpha)=`),
  })),
};
---

<CellBernsteinExpressionExplorer mathMarkup={mathMarkup} client:visible />
