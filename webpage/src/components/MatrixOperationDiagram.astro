---
import DiagramFrame from "./DiagramFrame.astro";

interface Props {
  kind: "align" | "product" | "transform" | "summary" | "assemble" | "index" | "reorder" | "shape";
  caption: string;
}

const { kind, caption } = Astro.props;
---

<DiagramFrame caption={caption} class="operation-diagram">
  <div class:list={["operation-flow", `operation-flow--${kind}`]}>
    {kind === "align" && (
      <><div class="operation-card"><small>degree 1</small><code>[1, 2]</code></div><b>+</b><div class="operation-card"><small>degree 2</small><code>[10, 20, 30]</code></div><b>→</b><div class="operation-card operation-card--result"><small>aligned degree 2</small><code>[11, 21.5, 32]</code></div></>
    )}
    {kind === "product" && (
      <><div class="coefficient-line coefficient-line--first"><span>P⁽ᶜ⁾[0]</span><span>P⁽ᶜ⁾[1]</span></div><b>×</b><div class="coefficient-line coefficient-line--second"><span>Q⁽ᶜ⁾[0]</span><span>Q⁽ᶜ⁾[1]</span></div><b>→</b><div class="coefficient-line operation-card--result"><span>R⁽ᶜ⁾[0]</span><span>R⁽ᶜ⁾[1]</span><span>R⁽ᶜ⁾[2]</span></div></>
    )}
    {kind === "transform" && (
      <><div class="matrix"><span>1</span><span>2</span><span>3</span><span>4</span></div><b>reshape / vec →</b><div class="vector"><span>1</span><span>3</span><span>2</span><span>4</span></div></>
    )}
    {kind === "summary" && (
      <><div class="matrix"><span>1</span><span>2</span><span>3</span><span>4</span></div><b>diag / trace →</b><div class="operation-card operation-card--result"><code>[1; 4]</code><code>5</code></div></>
    )}
    {kind === "assemble" && (
      <><div class="matrix matrix--one"><span>A</span></div><b>blkdiag →</b><div class="matrix operation-card--result"><span>A</span><span>0</span><span>0</span><span>A</span></div></>
    )}
    {kind === "index" && (
      <><div class="matrix"><span>1</span><span class="focus">2</span><span>3</span><span>4</span></div><b>A(1,2) →</b><div class="operation-card operation-card--result"><code>2</code></div></>
    )}
    {kind === "reorder" && (
      <><div class="matrix"><span>1</span><span>2</span><span>3</span><span>4</span></div><b>flip / rot90 →</b><div class="matrix operation-card--result"><span>2</span><span>4</span><span>1</span><span>3</span></div></>
    )}
    {kind === "shape" && (
      <><div class="matrix"><span>•</span><span>•</span><span>•</span><span>•</span></div><b>inspect →</b><div class="operation-card operation-card--result"><code>size = [2 2]</code><code>numel = 4</code></div></>
    )}
  </div>
</DiagramFrame>

<style>
  .operation-flow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    min-width: 0;
    min-height: 6rem;
    align-items: center;
    justify-content: center;
  }

  .operation-flow > b {
    color: var(--sl-color-text-accent);
    white-space: nowrap;
  }

  .operation-card {
    display: grid;
    gap: 0.3rem;
    place-items: center;
    border: 1px solid var(--diagram-border);
    border-radius: 9px;
    padding: 0.55rem 0.7rem;
    text-align: center;
    background: var(--sl-color-bg);
  }

  .operation-card small { color: var(--sl-color-gray-2); }
  .operation-card--result { color: var(--diagram-result); }

  .matrix {
    display: grid;
    grid-template-columns: repeat(2, 2.35rem);
    gap: 0.18rem;
    border-inline: 2px solid var(--sl-color-text);
    padding: 0.3rem;
  }

  .matrix--one { grid-template-columns: 2.35rem; }

  .matrix span,
  .vector span {
    display: grid;
    min-height: 2rem;
    place-items: center;
    border-radius: 4px;
    background: var(--sl-color-bg);
  }

  .matrix .focus { color: white; background: var(--sl-color-accent); }
  .vector { display: grid; gap: 0.18rem; }

  @media (max-width: 520px) {
    .operation-flow { flex-direction: column; }
    .operation-flow > b { white-space: normal; text-align: center; }
  }
</style>
