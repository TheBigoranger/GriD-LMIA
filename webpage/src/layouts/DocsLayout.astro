---
import "../styles/docs.css";

const { title, description = "DP-LMI package documentation for Bernstein gridded MATLAB/YALMIP workflows." } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const nav = [
  ["Background", "background/"],
  ["Setup", "setup/"],
  ["API", "api/"],
  ["Examples", "examples/"],
  ["Status", "status/"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}>DP-LMI Package</a>
      <nav aria-label="Primary documentation">
        {nav.map(([label, href]) => <a href={`${base}${href}`}>{label}</a>)}
      </nav>
    </header>
    <main class="page-shell">
      <slot />
    </main>
    <footer class="footer">
      Documentation source:{" "}<code>webpage/</code>. Manual path:{" "}
      <code>doc/manual.tex</code>. Both describe the current MATLAB code and tests.
    </footer>
  </body>
</html>
